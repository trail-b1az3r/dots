groups=(illogical-impulse)
pkgname=illogical-impulse-summit
pkgver=1.0
pkgrel=3
pkgdesc='Halcyon: what Summit, the HyperNeo v2 theme shell, needs, and its forecast window (halcyon-forecast)'
arch=(x86_64 aarch64)
license=('GPL-3.0-only' 'Apache-2.0' 'OFL-1.1')
depends=(
  # Summit's menus: apps, windows, clipboard, power, forecast list (halcyon/summit/rofi-menu)
  rofi
  cliphist
  wl-clipboard
  # Its lock screen (Summit has none of its own)
  hyprlock
  # Its type and icons: Summit Sans (below) for text, Iosevka Nerd Font for code
  inter-font
  ttf-material-symbols-variable-git
  ttf-iosevka-nerd
  # The side menu: brightness, night light and dimming, the colour picker, screenshots, the timer's alert
  brightnessctl
  hyprsunset
  hyprpicker
  hyprshot
  libnotify
  # The forecast window is an Iced app
  gcc-libs
  libxkbcommon
  wayland
  vulkan-icd-loader
)
optdepends=('ddcutil: brightness of external monitors (DDC/CI) from the side menu')
makedepends=(cargo)
# Summit's icons (a cut of Material Symbols Rounded, Apache-2.0) and its text font (Summit Sans: Google Sans Flex
# modified, OFL-1.1), for fontconfig, so Rofi draws them too: copies of dots/.config/quickshell/Summit/assets/fonts
# (tests/test_halcyon_summit.py keeps them equal).
source=(SummitSymbols.ttf SummitSans.ttf SummitSans-OFL.txt)
sha256sums=('c5da265671a0021dd52ab560968b7878f512247a517c0b3d4a7b7e576480c84a'
            'a5944fed6f35c148985da1163786b39905ad8e187847ea2d2d786f5ddd312a2c'
            'fc13d69f63e36d284b6e383d4d1463d8ad404f0aa065e57cf961252d51063137')

# The source is this repository's tools/halcyon-forecast, next to this folder.
_src="$startdir/../../../tools/halcyon-forecast"

prepare() {
  cp -a "$_src" "$srcdir/halcyon-forecast"
  cd "$srcdir/halcyon-forecast"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/halcyon-forecast"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$srcdir/halcyon-forecast"
  install -Dm755 target/release/halcyon-forecast "$pkgdir/usr/bin/halcyon-forecast"
  install -Dm644 assets/README.md "$pkgdir/usr/share/licenses/$pkgname/weather-icons.md"
  install -Dm644 "$srcdir/SummitSymbols.ttf" "$pkgdir/usr/share/fonts/halcyon/SummitSymbols.ttf"
  install -Dm644 "$srcdir/SummitSans.ttf" "$pkgdir/usr/share/fonts/halcyon/SummitSans.ttf"
  install -Dm644 "$srcdir/SummitSans-OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/SummitSans-OFL.txt"
}
