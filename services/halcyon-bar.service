[Unit]
Description=Halcyon status bar (Waybar)
PartOf=halcyon-session.target
After=halcyon-session.target
StartLimitIntervalSec=90
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/env waybar -c %h/.config/halcyon/generated/waybar-config.jsonc -s %h/.config/waybar/style.css
# SIGUSR2 makes Waybar re-read its stylesheet without dropping the bar.
ExecReload=/usr/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=halcyon-session.target
