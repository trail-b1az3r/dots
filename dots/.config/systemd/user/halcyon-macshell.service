[Unit]
Description=MacShell desktop shell (Quickshell), the Liquid Glass theme's shell
Documentation=file://%h/.config/quickshell/MacShell/shell.qml
# One desktop shell at a time: starting this stops the Halcyon shell, and starting that stops this.
# halcyon-theme picks which (a theme's "desktop_shell"); halcyon/desktop-shell starts the right one at login.
Conflicts=halcyon-quickshell.service
# The power button's lock (the Halcyon shell holds its own): stopped with this, through its BindsTo=.
Wants=halcyon-power-key.service

[Service]
# Only inside a running Hyprland, as for halcyon-quickshell.service.
ExecCondition=/bin/sh -c 'hyprctl version >/dev/null 2>&1 || exit 1'
# The wallpaper: MacShell draws none of its own. halcyon-theme sets it with awww (MacShell's own wallpaper tool, which
# it starts when it is needed), and MacShell refracts it in its glass.
ExecStart=/usr/bin/env qs -c MacShell
Restart=on-failure
RestartSec=2
# The same as the Halcyon shell: apps opened from the Dock or Spotlight are children of the shell, so only the shell is
# stopped on a restart, and they are asked to quit when the session ends.
KillMode=process
OOMPolicy=continue
ExecStopPost=%h/.config/hypr/hyprland/halcyon/session-end

# Started by halcyon/desktop-shell (from Hyprland) or halcyon-theme, never enabled on its own.
