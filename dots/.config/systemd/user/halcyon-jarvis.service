[Unit]
Description=Halcyon: Jarvis, the offline voice assistant (halcyon jarvis)
# A missing microphone or model: give up after three tries instead of retrying forever.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
# Only inside a running Hyprland (the user manager outlives a session; see halcyon-auto-theme.service).
ExecCondition=/bin/sh -c 'hyprctl version >/dev/null 2>&1 || exit 1'
ExecStart=%h/.local/share/halcyon/jarvis-linux/run-jarvis
# "Jarvis exit" ends it cleanly, and it stays stopped until the next login; a crash starts it again.
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
