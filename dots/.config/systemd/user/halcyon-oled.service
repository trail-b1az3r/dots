[Unit]
Description=Halcyon: move OLED care's dimmed pixels (hyproled)

[Service]
# Only inside a running Hyprland (the user manager outlives a session; see halcyon-auto-theme.service).
ExecCondition=/bin/sh -c 'hyprctl version >/dev/null 2>&1 || exit 1'
Type=oneshot
ExecStart=%h/.config/hypr/hyprland/halcyon/halcyon_oled.py shift
