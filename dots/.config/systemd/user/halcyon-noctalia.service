[Unit]
Description=Noctalia Shell v5, the desktop shell Halcyon runs when you pick it (halcyon shell noctalia)
Documentation=https://github.com/noctalia-dev/noctalia
# One desktop shell at a time: starting this stops the others, and starting one of them stops this.
# halcyon-theme picks which; halcyon/desktop-shell starts the right one at login.
Conflicts=halcyon-quickshell.service halcyon-macshell.service halcyon-summit.service

[Service]
# Only inside a running Hyprland, as for halcyon-quickshell.service, and only with the noctalia package installed.
ExecCondition=/bin/sh -c 'hyprctl version >/dev/null 2>&1 && command -v noctalia >/dev/null 2>&1'
ExecStart=/usr/bin/env noctalia
Restart=on-failure
RestartSec=2
# Apps opened from its launcher are children of the shell: only the shell is stopped on a restart.
KillMode=process
OOMPolicy=continue
ExecStopPost=%h/.config/hypr/hyprland/halcyon/session-end

# Started by halcyon/desktop-shell (from Hyprland) or halcyon-theme, never enabled on its own.
