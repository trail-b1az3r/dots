[Unit]
Description=Halcyon desktop shell (Quickshell)
Documentation=file://%h/.config/quickshell/ii/shell.qml

[Service]
# Only inside a running Hyprland. systemd's user manager outlives a session, so without this a restart after
# Hyprland exits (or an enabled unit at the next login) would start it in KDE or GNOME instead.
ExecCondition=/bin/sh -c 'hyprctl version >/dev/null 2>&1 || exit 1'
ExecStart=/usr/bin/env qs -c ii
Restart=on-failure
RestartSec=2
# Apps opened from the shell (launcher, dock, search, revolver) are its child processes, so they run in this
# service's cgroup. With systemd's defaults, a restart of the shell would kill them all, and so would one of them
# being killed for memory (OOMPolicy=stop stops the whole unit). That is what made Vesktop, Spotify and media
# players close "after a while". Only the shell itself is stopped now, and an app killed for memory takes nothing
# else with it.
KillMode=process
OOMPolicy=continue

# Started by Hyprland (halcyon/init.lua), never enabled on its own: see ExecCondition.
