#!/usr/bin/env bash
# Halcyon: a systemd sleep hook, run as root after the computer resumes.
#
# The user's halcyon-resume watcher is tried first. This is the fallback: a few
# seconds after resume, if Bluetooth's adapter is off, it restarts bluetoothd and
# powers the adapter on. Then, if NetworkManager still isn't "connected", it
# restarts NetworkManager itself, and checks again. A working network is left alone.
#
# The check runs as a detached unit, so the resume isn't held up waiting for it.
# Every step is allowed to fail: a sleep hook must never block suspend or wake.
#
# ./setup install fills in the user name and copies this to
# /usr/lib/systemd/system-sleep/halcyon-resume.
set -u

[ "${1:-}" = post ] || exit 0

USER_NAME="__USER__"

RECHECK='
network_up() { nmcli -t -f STATE general status 2>/dev/null | grep -qx connected; }
wait_for_network() {
    for _ in $(seq 1 "$1"); do
        network_up && return 0
        sleep 1
    done
    network_up
}

bluetooth_on() { timeout 5 bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; }
restart_bluetooth_if_off() {
    command -v bluetoothctl >/dev/null || return 0
    bluetooth_on && return 0
    logger -t halcyon-resume "bluetooth is off after resume; restarting bluetoothd"
    rfkill unblock bluetooth 2>/dev/null || true
    systemctl restart bluetooth.service || logger -t halcyon-resume "could not restart bluetooth.service"
    for _ in 1 2 3 4 5; do
        sleep 2
        timeout 5 bluetoothctl power on >/dev/null 2>&1 || true
        bluetooth_on && break
    done
    if bluetooth_on; then
        logger -t halcyon-resume "bluetooth is on again"
    else
        logger -t halcyon-resume "bluetooth is still off after resume"
    fi
}

sleep 6
restart_bluetooth_if_off
if wait_for_network 12; then
    logger -t halcyon-resume "network is up after resume"
    exit 0
fi
logger -t halcyon-resume "network still down after resume; restarting NetworkManager"
systemctl restart NetworkManager.service || logger -t halcyon-resume "could not restart NetworkManager"
if wait_for_network 25; then
    logger -t halcyon-resume "network is up again"
else
    logger -t halcyon-resume "network is still down after restarting NetworkManager"
fi
systemctl --machine="__USER__@" --user restart openrazer-daemon.service 2>/dev/null || true
'

systemd-run --no-block --collect --unit="halcyon-resume-check-$(date +%s)" \
    /bin/bash -c "$RECHECK" >/dev/null 2>&1 || true

exit 0
