#!/usr/bin/env bash
# Summit's menus, in Rofi with Summit's look (summit.rasi, here) and the active theme's colours.
#
#   rofi-menu apps        the app launcher (Super+Space, the bar's mountain button)
#   rofi-menu windows     the open windows (Alt+Tab)
#   rofi-menu clipboard   the clipboard history, from cliphist (Super+V)
#   rofi-menu power       lock, log out, sleep, restart, shut down (the power button, Super+Escape)
#   rofi-menu forecast    the week's weather: halcyon-forecast's window when it is built, else a list here
#   rofi-menu keys        every keybind with a description (Super+/), searchable; Enter runs the chosen one
#   rofi-menu docs        your documents, searched by what they say (`frontline docs`, local only); also a tab in apps
#
# A second press closes the open menu. Your own ~/.config/rofi is not read or changed.
set -u

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
halcyon="$(dirname -- "$here")"
state="${XDG_STATE_HOME:-$HOME/.local/state}/halcyon"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/halcyon"
mode="${1:-apps}"

if ! command -v rofi >/dev/null 2>&1; then
    command -v notify-send >/dev/null 2>&1 && notify-send -a Summit "Rofi is not installed" \
        "Summit's menus use it: sudo pacman -S rofi"
    exit 1
fi
# A second press of the same key closes the menu.
if pkill -x rofi 2>/dev/null; then
    exit 0
fi

# The prompts' icons are Summit's cut of Material Symbols (Summit Symbols): fontconfig needs it once for Rofi to find it.
fonts="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/halcyon"
symbols="$HOME/.config/quickshell/Summit/assets/fonts/SummitSymbols.ttf"
if [[ -r "$symbols" ]] && ! cmp -s "$symbols" "$fonts/SummitSymbols.ttf"; then
    mkdir -p "$fonts" && cp -f "$symbols" "$fonts/SummitSymbols.ttf" && fc-cache -f "$fonts" >/dev/null 2>&1
fi

theme_args=(-config "${SUMMIT_ROFI_CONFIG:-$here/summit.rasi}")
if [[ -r "$state/summit-colors.rasi" ]]; then
    theme_args+=(-theme-str "$(cat -- "$state/summit-colors.rasi")")
fi

r() { rofi "${theme_args[@]}" "$@"; }

# One row: its text, then the icon name rofi shows next to it.
row() { printf '%s\0icon\x1f%s\n' "$1" "$2"; }

power_menu() {
    local choice
    choice="$({
        row "Lock" system-lock-screen
        row "Log out" system-log-out
        row "Sleep" system-suspend
        row "Restart" system-reboot
        row "Shut down" system-shutdown
    } | r -dmenu -i -p power_settings_new -mesg "Goodbye for now, ${USER:-you}" -selected-row 4 \
        -theme-str 'listview { lines: 5; } window { width: 380px; }')" || exit 0
    case "$choice" in
        "Lock") exec "$halcyon/lock" ;;
        "Log out")
            hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 || hyprctl dispatch exit >/dev/null 2>&1 \
                || loginctl terminate-session "${XDG_SESSION_ID:-}" ;;
        "Sleep") exec systemctl suspend ;;
        "Restart") exec systemctl reboot ;;
        "Shut down") exec systemctl poweroff ;;
    esac
}

clipboard_menu() {
    if ! command -v cliphist >/dev/null 2>&1; then
        notify-send -a Summit "Clipboard history is off" "Install cliphist for it" 2>/dev/null
        exit 1
    fi
    local choice
    choice="$(cliphist list | r -dmenu -i -p content_paste -display-columns 2 \
        -mesg "Enter copies it again · Shift+Delete forgets it" -kb-custom-1 "Shift+Delete")"
    local code=$?
    [[ -n "$choice" ]] || exit 0
    case "$code" in
        0) printf '%s' "$choice" | cliphist decode | wl-copy ;;
        10) printf '%s' "$choice" | cliphist delete; exec "$0" clipboard ;;
    esac
}

forecast_menu() {
    for app in "${HALCYON_FORECAST:-}" "$HOME/.local/bin/halcyon-forecast" halcyon-forecast; do
        [[ -n "$app" ]] && command -v "$app" >/dev/null 2>&1 && exec "$app"
    done
    # No window built: the same forecast as a list (halcyon_weather.py writes it).
    local text
    text="$(python3 "$halcyon/halcyon_weather.py" rows 2>/dev/null)" || text=""
    if [[ -z "$text" ]]; then
        text="$(row "No forecast yet: right-click the weather in the bar to fetch it" weather-few-clouds)"
    fi
    local place
    place="$(python3 "$halcyon/halcyon_weather.py" place 2>/dev/null)" || place=""
    printf '%s\n' "$text" | r -dmenu -i -p partly_cloudy_day -mesg "${place:-Weather}" -no-custom \
        -theme-str 'listview { lines: 7; } window { width: 460px; } entry { enabled: false; }' >/dev/null
}

keys_menu() {
    # Hyprland's binds with a description, as "Super + Shift + T    Shell: ..." (modmask bits: Shift 1, Ctrl 4,
    # Alt 8, Super 64). The chosen line's number picks the bind to run (hyprctl dispatch DISPATCHER ARG).
    local binds lines choice
    binds="$(hyprctl binds -j 2>/dev/null)" || exit 1
    lines="$(printf '%s' "$binds" | python3 -c '
import json, sys
mods = ((64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift"))
seen = set()
for b in json.load(sys.stdin):
    desc = (b.get("description") or "").strip()
    if not desc:
        continue
    keys = [name for bit, name in mods if b.get("modmask", 0) & bit] + [b.get("key", "").replace("_", " ").title()]
    chord = " + ".join(k for k in keys if k)
    if (chord, desc) in seen:
        continue
    seen.add((chord, desc))
    print(json.dumps([chord, desc, b.get("dispatcher", ""), b.get("arg", "")]))
')" || exit 1
    [[ -n "$lines" ]] || exit 0
    choice="$(printf '%s\n' "$lines" | python3 -c '
import json, sys
for line in sys.stdin:
    chord, desc = json.loads(line)[:2]
    print(f"{chord:<26}{desc}")
' | r -dmenu -i -p keyboard -format i -mesg "Halcyon's keys · Enter runs one" \
        -theme-str 'window { width: 760px; } listview { lines: 12; } element-icon { enabled: false; }
                    element-text { font: "JetBrainsMono Nerd Font 10"; }')" || exit 0
    [[ "$choice" =~ ^[0-9]+$ ]] || exit 0
    printf '%s\n' "$lines" | sed -n "$((choice + 1))p" | python3 -c '
import json, subprocess, sys
_, _, dispatcher, arg = json.loads(sys.stdin.read())
def dispatch(*args):
    return subprocess.run(["hyprctl", "dispatch", *args], capture_output=True, text=True).stdout.strip() == "ok"
# Hyprland 0.55+ takes Lua (hl.dsp.exec_cmd("...")); older ones the plain dispatcher.
if dispatcher == "exec" and arg:
    dispatch("hl.dsp.exec_cmd(" + json.dumps(arg) + ")") or dispatch("exec", arg)
elif dispatcher:
    dispatch(dispatcher, arg) if arg else dispatch(dispatcher)
'
}

case "$mode" in
    apps)
        # Documents is the second tab (Tab or Shift+→ moves to it) where the document index exists.
        if [[ -x "$here/rofi-docs" ]] && command -v "${FRONTLINE_CLI:-frontline}" >/dev/null 2>&1; then
            r -modi "drun,docs:$here/rofi-docs" -display-drun Apps -display-docs Documents -show drun -p apps
        else
            r -show drun -p apps
        fi ;;
    docs) r -modi "docs:$here/rofi-docs" -display-docs Documents -show docs ;;
    windows) r -show window -p select_window ;;
    clipboard) clipboard_menu ;;
    power) power_menu ;;
    forecast) forecast_menu ;;
    keys) keys_menu ;;
    *) echo "usage: rofi-menu [apps|windows|clipboard|power|forecast|keys|docs]" >&2; exit 2 ;;
esac
