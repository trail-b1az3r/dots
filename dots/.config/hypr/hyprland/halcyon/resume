#!/usr/bin/env bash
# Halcyon: after the computer wakes from suspend, bring the network back and
# restart the Razer tools, which often lose their state across a sleep.
#
# logind announces suspend and resume on the system bus (PrepareForSleep):
# "true" just before sleeping, "false" once awake again. Only the wake-up
# does anything here.
#
# Cycling networking restarts NetworkManager's devices without needing root,
# so no password prompt appears at wake-up.
set -u

restart_network() {
    nmcli networking off && sleep 2 && nmcli networking on
}

# If the network still isn't up a while after that, reconnect the last Wi-Fi
# by hand (wifi-reconnect). It runs detached, so the watcher keeps listening.
reconnect_wifi_if_down() {
    sleep 15
    nmcli -t -f STATE general status 2>/dev/null | grep -qx connected && return 0
    setsid "$(dirname "$0")/wifi-reconnect" >/dev/null 2>&1 &
}

restart_razer() {
    systemctl --user restart openrazer-daemon.service 2>/dev/null || true
    if command -v polychromatic-tray-applet >/dev/null && ! pgrep -f polychromatic-tray-applet >/dev/null; then
        setsid polychromatic-tray-applet >/dev/null 2>&1 &
    fi
}

bluetooth_on() {
    timeout 5 bluetoothctl show 2>/dev/null | grep -q "Powered: yes"
}

# After a suspend the adapter is often off, and nothing turns it back on. Unblock it and power it on, a few
# times, since bluetoothd needs a moment. Runs detached, so the watcher keeps listening. The system sleep
# hook is the fallback that restarts bluetoothd itself.
restart_bluetooth() {
    command -v bluetoothctl >/dev/null || return 0
    bluetooth_on && return 0
    rfkill unblock bluetooth 2>/dev/null || true
    for _ in 1 2 3; do
        timeout 5 bluetoothctl power on >/dev/null 2>&1 || true
        sleep 2
        bluetooth_on && return 0
    done
}

dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" |
while read -r line; do
    case "$line" in
        *"boolean false"*)
            sleep 3  # give the hardware a moment to come back
            restart_network
            ( reconnect_wifi_if_down ) &
            restart_razer
            ( restart_bluetooth ) &
            ;;
    esac
done
