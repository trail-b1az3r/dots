#!/usr/bin/env bash
# Halcyon: after the computer wakes from suspend, bring the network back and
# restart the Razer tools, which often lose their state across a sleep.
#
# logind announces suspend and resume on the system bus (PrepareForSleep):
# "true" just before sleeping, "false" once awake again. Only the wake-up
# does anything here.
#
# Cycling networking restarts NetworkManager's devices without needing root,
# so no password prompt appears at wake-up.
set -u

restart_network() {
    nmcli networking off && sleep 2 && nmcli networking on
}

restart_razer() {
    systemctl --user restart openrazer-daemon.service 2>/dev/null || true
    if command -v polychromatic-tray-applet >/dev/null && ! pgrep -f polychromatic-tray-applet >/dev/null; then
        setsid polychromatic-tray-applet >/dev/null 2>&1 &
    fi
}

dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" |
while read -r line; do
    case "$line" in
        *"boolean false"*)
            sleep 3  # give the hardware a moment to come back
            restart_network
            restart_razer
            ;;
    esac
done
