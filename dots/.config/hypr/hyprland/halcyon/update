#!/usr/bin/env bash
# Halcyon updater. Most changes are config files, so they don't need a full
# ./setup install: `apply` pulls the repository and copies only the files that
# changed. Anything under sdata/ or setup needs ./setup install instead, and
# this says so.
#
#   update check    look for new commits on main; one notification for them, at most one an hour (the default).
#                   The notification's "Update now" runs apply.
#   update apply    bring the repository to main, copy the changed dots/ files into $HOME, reload what they change,
#                   then update hyprland-plus (the Hyprland fork) when its branch has moved on
#   update apply halcyon          only Halcyon
#   update apply hyprland-plus    only hyprland-plus
#   update status   what is installed, what is waiting, and the last problem
#
# hyprland-plus is built by hyprctl-lite (tools/hyprctl-lite in the repository, so the newest copy), which needs sudo:
# in a terminal it asks there; from the shell's button (no terminal) it opens one to ask in. One installed from the
# AUR is updated with your AUR helper the same way.
#
# It follows main whatever the repository is on: another branch, a detached checkout, a clone with no upstream, or
# a release archive with no git at all (that one becomes a clone of the repository on its first update).
# A failure is shown as a notification as well as printed, since the shell's button runs this with no terminal.
# Files being replaced are backed up first, under ~/.local/state/halcyon/backups.
set -u

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/halcyon"
REPO_FILE="$STATE/repo"                 # written by ./setup install
INSTALLED_FILE="$STATE/installed"       # the commit whose dots/ files are in $HOME
SEEN_FILE="$STATE/update-seen"          # the last upstream commit already announced
AVAILABLE_FILE="$STATE/update-available"  # how many commits are waiting; the shell's indicator reads it
NOTIFIED_FILE="$STATE/update-notified"  # when the last notification went out (epoch seconds)
ERROR_FILE="$STATE/update-error"        # the last failure, for the shell and `update status`
CHECKED_FILE="$STATE/update-checked"    # when the last check reached the repository
BACKUPS="$STATE/backups"
PLUS_FILE="$STATE/hyprland-plus-update"  # hyprland-plus's update, when one is waiting (hyprctl-lite's words)
PLUS_SEEN_FILE="$STATE/hyprland-plus-seen"  # the last hyprland-plus update already announced
REMOTE_URL="${HALCYON_REMOTE:-https://github.com/trail-b1az3r/dots.git}"
BRANCH="main"
TARGET_REF="refs/remotes/origin/$BRANCH"

mkdir -p "$STATE"

g() { git -C "$REPO" "$@"; }

notify() {
    # notify TITLE BODY [extra notify-send arguments]
    local title="$1" body="$2"
    shift 2
    command -v notify-send >/dev/null 2>&1 && notify-send -a Halcyon -i software-update-available "$@" "$title" "$body"
    echo "$title: $body"
}

# A problem the user has to see. From the timer, the same problem is shown once a day at most.
fail() {
    local message="$1" previous=""
    echo "halcyon update: $message" >&2
    # `update status` only reports: no notification, and the last problem stays the last real one.
    [[ "${MODE:-}" == status ]] && exit 1
    [[ -f "$ERROR_FILE" ]] && previous="$(cat "$ERROR_FILE")"
    if [[ "${MODE:-}" != check || "$previous" != "$message" ]] || [[ -n "$(find "$ERROR_FILE" -mmin +1440 2>/dev/null)" ]]; then
        command -v notify-send >/dev/null 2>&1 && notify-send -a Halcyon -i dialog-error "Halcyon update failed" "$message"
    fi
    printf '%s\n' "$message" > "$ERROR_FILE"
    exit 1
}

# The repository ./setup install recorded. A release archive (no .git) is made a git repository here, with the
# upstream as origin; it has no commits yet, which is how the rest knows it came from an archive.
repo() {
    [[ -r "$REPO_FILE" ]] || fail "No repository is recorded. Run ./setup install once from the Halcyon folder."
    REPO="$(cat "$REPO_FILE")"
    [[ -d "$REPO" ]] || fail "The Halcyon folder $REPO is gone. Clone it again and run ./setup install."
    if [[ ! -e "$REPO/.git" ]]; then
        git init -q -b "$BRANCH" "$REPO" 2>/dev/null || fail "Couldn't make $REPO a git repository."
    fi
    g remote get-url origin >/dev/null 2>&1 || g remote add origin "$REMOTE_URL"
}

has_commits() { g rev-parse -q --verify HEAD >/dev/null 2>&1; }

# Fetches main into origin/main, whatever the clone's own fetch settings. Fails (returns 1) when offline.
fetch() {
    g fetch --quiet origin "+refs/heads/$BRANCH:$TARGET_REF" 2>/dev/null || return 1
    TARGET="$(g rev-parse "$TARGET_REF")"
    date +%s > "$CHECKED_FILE"
}

# How far behind main this install is: commits for a clone, changed files for an archive. 0 when up to date,
# including when the checkout already has everything main has (a branch made from it).
behind() {
    if ! has_commits; then
        g diff --name-only "$TARGET" -- dots sdata setup 2>/dev/null | grep -c . || true
        return
    fi
    if g merge-base --is-ancestor "$TARGET" HEAD 2>/dev/null; then
        echo 0
        return
    fi
    g rev-list --count "HEAD..$TARGET"
}

# --- hyprland-plus ---------------------------------------------------------------------------------------------------

# hyprctl-lite: the repository's copy (just updated, so it knows the current branch), else an installed one.
plus_lite() {
    local lite candidates=("${REPO:-}/tools/hyprctl-lite/hyprctl-lite" /usr/local/bin/hyprctl-lite)
    [[ -n "${HALCYON_HYPRCTL_LITE+set}" ]] && candidates=("$HALCYON_HYPRCTL_LITE")   # the tests' stand-in, alone
    for lite in "${candidates[@]}"; do
        [[ -n "$lite" && -f "$lite" ]] && { echo "$lite"; return 0; }
    done
    return 1
}

# Sets PLUS_STATE (waiting, current, aur, none or unknown) and PLUS_LINE (what hyprctl-lite said).
plus_check() {
    PLUS_STATE=none PLUS_LINE=""
    local lite rc=0
    lite="$(plus_lite)" || return 0
    PLUS_LINE="$(timeout 60 bash "$lite" install update --check 2>&1)" || rc=$?
    PLUS_LINE="${PLUS_LINE%%$'\n'*}"
    case "$rc" in
        0) PLUS_STATE=current ;;
        10) PLUS_STATE=waiting ;;
        *) case "$PLUS_LINE" in
               *AUR*) PLUS_STATE=aur ;;
               *"not installed"*) PLUS_STATE=none ;;
               *) PLUS_STATE=unknown ;;
           esac ;;
    esac
    if [[ "$PLUS_STATE" == waiting ]]; then
        printf '%s\n' "$PLUS_LINE" > "$PLUS_FILE"
    else
        rm -f "$PLUS_FILE"
    fi
}

aur_helper() {
    local helper
    for helper in paru yay pikaur trizen; do
        command -v "$helper" >/dev/null 2>&1 && { echo "$helper"; return 0; }
    done
    return 1
}

# Runs a command that asks for a password: here when there is a terminal, else in a new terminal window (the shell's
# button and the notification's "Update now" have none), which stays open at the end so its output can be read.
in_terminal() {
    local title="$1"
    shift
    if [[ -t 0 && -t 1 ]]; then
        "$@"
        return
    fi
    local script term
    script="$(printf '%q ' "$@"); echo; read -rp 'Done. Press Enter to close this window. ' _"
    for term in "${TERMINAL:-}" xdg-terminal-exec kitty foot ghostty alacritty wezterm konsole gnome-terminal xterm; do
        [[ -n "$term" ]] && command -v "$term" >/dev/null 2>&1 && break
        term=""
    done
    [[ -n "$term" ]] || { notify "$title" "No terminal to ask for your password in. Run in one: $*" -u critical; return 1; }
    case "$term" in
        xdg-terminal-exec|kitty|foot) setsid -f "$term" bash -c "$script" >/dev/null 2>&1 ;;
        wezterm) setsid -f wezterm start -- bash -c "$script" >/dev/null 2>&1 ;;
        gnome-terminal) setsid -f gnome-terminal -- bash -c "$script" >/dev/null 2>&1 ;;
        *) setsid -f "$term" -e bash -c "$script" >/dev/null 2>&1 ;;
    esac
    notify "$title" "Building in a terminal window: it asks for your password. Log out and back in when it is done." -u normal
}

plus_apply() {
    plus_check
    case "$PLUS_STATE" in
        waiting)
            echo "hyprland-plus: $PLUS_LINE"
            in_terminal "Updating hyprland-plus" sudo bash "$(plus_lite)" install update ;;
        aur)
            local helper
            helper="$(aur_helper)" || { echo "hyprland-plus is from the AUR, and no AUR helper is installed"; return 0; }
            in_terminal "Updating hyprland-plus" "$helper" -S --needed hyprland-plus ;;
        current) echo "hyprland-plus: $PLUS_LINE" ;;
        none) echo "hyprland-plus: not installed (sudo hyprctl-lite install full installs it)" ;;
        *) echo "hyprland-plus: couldn't tell whether an update is waiting: $PLUS_LINE" ;;
    esac
    return 0
}

check() {
    MODE=check
    repo
    # Another check or an apply is running: this one has nothing to add.
    exec 9>"$STATE/update.lock"
    flock -n 9 || { echo "an update is already running"; return 0; }
    # Offline is not an error: say nothing, and the next check tries again.
    fetch || { echo "no network: the update check will try again later"; return 0; }
    local count
    count="$(behind)"
    rm -f "$ERROR_FILE"
    plus_check
    if [[ "$count" == 0 ]]; then
        if [[ "$PLUS_STATE" == waiting ]]; then
            # Halcyon is current, hyprland-plus isn't: the bar's button lights for it, announced once per new commit.
            echo 1 > "$AVAILABLE_FILE"
            echo "hyprland-plus: $PLUS_LINE"
            [[ "$(cat "$PLUS_SEEN_FILE" 2>/dev/null)" == "$PLUS_LINE" ]] && return 0
            echo "$PLUS_LINE" > "$PLUS_SEEN_FILE"
            flock -u 9
            local answer
            answer="$(timeout 3600 notify-send -a Halcyon -i software-update-available -A "apply=Update now" --wait \
                "hyprland-plus update available" "$PLUS_LINE" 2>/dev/null)"
            [[ "$answer" == apply ]] && bash "$0" apply hyprland-plus
            return 0
        fi
        rm -f "$AVAILABLE_FILE"
        echo "up to date"
        return 0
    fi
    echo "$count" > "$AVAILABLE_FILE"
    [[ "$(cat "$SEEN_FILE" 2>/dev/null)" == "$TARGET" ]] && { echo "$count update(s) waiting (already announced)"; return 0; }
    # One notification however many commits came in. If one was sent within the hour, this one waits for the next
    # check: SEEN_FILE is only written once something was shown.
    local now last
    now="$(date +%s)"
    last="$(cat "$NOTIFIED_FILE" 2>/dev/null || echo 0)"
    if (( now - last < 3600 )); then
        echo "update available; already notified within the hour"
        return 0
    fi
    local subject body unit="commit" plural=""
    subject="$(g log -1 --format=%s "$TARGET")"
    has_commits || unit="changed file"
    (( count > 1 )) && plural="s"
    body="$count new $unit$plural on main. Latest: $subject"
    if has_commits && [[ -n "$(g diff --name-only HEAD "$TARGET" -- sdata setup)" ]]; then
        body+=" (afterwards run ./setup install, since install steps or packages changed)"
    fi
    [[ "$PLUS_STATE" == waiting ]] && body+=" hyprland-plus has an update too."
    echo "$TARGET" > "$SEEN_FILE"
    echo "$now" > "$NOTIFIED_FILE"
    flock -u 9
    # "Update now" on the notification applies it. Waits up to an hour for an answer; without one, the indicator in
    # the bar and the sidebar's Update Halcyon button stay lit.
    local answer
    answer="$(timeout 3600 notify-send -a Halcyon -i software-update-available -A "apply=Update now" --wait \
        "Halcyon update available" "$body" 2>/dev/null)"
    echo "Halcyon update available: $body"
    if [[ "$answer" == apply ]]; then
        bash "$0" apply
    fi
}

apply() {
    MODE=apply
    local what="${1:-all}"
    case "$what" in
        all|halcyon|hyprland-plus) ;;
        *) echo "usage: update apply [halcyon|hyprland-plus]" >&2; exit 2 ;;
    esac
    repo
    if [[ "$what" == hyprland-plus ]]; then
        plus_apply
        rm -f "$AVAILABLE_FILE"
        return 0
    fi
    exec 9>"$STATE/update.lock"
    flock -w 300 9 || fail "Another update has been running for 5 minutes. Try again when it has finished."
    fetch || fail "Couldn't reach the Halcyon repository. Check the network and try again."

    local before after changed ts backup copied=0 needs_install=0 hypr_changed=0 shell_changed=0 units_changed=0
    local stashed="" from_archive=0
    ts="$(date +%Y%m%d-%H%M%S)"

    if ! has_commits; then
        # A release archive: the files that differ from main are the update. From now on it is a clone.
        from_archive=1
        changed="$(g diff --name-only "$TARGET" 2>/dev/null)"
        g reset -q --hard "$TARGET" || fail "Couldn't bring $REPO up to date with main."
        g branch -q --set-upstream-to "origin/$BRANCH" 2>/dev/null || true
        before="(archive)"
        after="$TARGET"
    else
        before="$(cat "$INSTALLED_FILE" 2>/dev/null)"
        g rev-parse -q --verify "${before:-x}^{commit}" >/dev/null 2>&1 || before="$(g rev-parse HEAD)"
        # Edits in the repository itself (not in $HOME) are put aside and put back after; submodules don't count.
        if ! g diff --quiet --ignore-submodules HEAD 2>/dev/null; then
            g stash push -q -m "halcyon update $ts" || fail "Couldn't put aside the edits in $REPO. See: git -C $REPO status"
            stashed=1
        fi
        # Updates come from main, so go back to it from another branch or a detached checkout.
        if [[ "$(g symbolic-ref --quiet --short HEAD 2>/dev/null)" != "$BRANCH" ]]; then
            if g rev-parse -q --verify "refs/heads/$BRANCH" >/dev/null; then
                g checkout -q "$BRANCH" || fail "Couldn't switch $REPO to main. See: git -C $REPO status"
            else
                g checkout -q -b "$BRANCH" "$TARGET" || fail "Couldn't switch $REPO to main. See: git -C $REPO status"
            fi
        fi
        g branch -q --set-upstream-to "origin/$BRANCH" 2>/dev/null || true
        if ! g merge -q --ff-only "$TARGET" 2>/dev/null; then
            [[ -n "$stashed" ]] && g stash pop -q 2>/dev/null
            fail "Your main in $REPO has commits that aren't on GitHub, so it can't simply move forward. Move them to another branch, then update again."
        fi
        if [[ -n "$stashed" ]] && ! g stash pop -q 2>/dev/null; then
            g checkout -q -- . 2>/dev/null
            notify "Halcyon update" "Your own edits in $REPO clash with the update. They are kept in: git -C $REPO stash list" -u normal
        fi
        after="$(g rev-parse HEAD)"
        changed="$(g diff --name-only "$before" "$after")"
    fi
    g submodule update --init --recursive --quiet 2>/dev/null || echo "note: couldn't update the git submodules"

    if [[ "$before" == "$after" ]]; then
        rm -f "$AVAILABLE_FILE" "$ERROR_FILE"
        echo "$after" > "$INSTALLED_FILE"
        echo "Already up to date."
        notify "Halcyon is up to date" "Nothing new on main." -u low
        [[ "$what" == all ]] && plus_apply
        return 0
    fi

    backup="$BACKUPS/$ts"
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        case "$path" in
            sdata/*|setup) needs_install=1; continue ;;
            dots/*) ;;
            *) continue ;;
        esac
        local rel="${path#dots/}" src="$REPO/$path" dest="$HOME/${path#dots/}"
        if [[ ! -e "$src" ]]; then
            echo "removed upstream, left in place: $dest"
            continue
        fi
        if [[ -d "$src" ]]; then
            # A submodule: its whole folder.
            mkdir -p "$dest"
            cp -a "$src/." "$dest/" && rm -rf "$dest/.git"
        else
            if [[ -e "$dest" ]] && ! cmp -s "$src" "$dest"; then
                mkdir -p "$backup/$(dirname "$rel")"
                cp -p "$dest" "$backup/$rel"
            fi
            mkdir -p "$(dirname "$dest")"
            cp -p "$src" "$dest"
        fi
        copied=$((copied + 1))
        [[ "$rel" == .config/hypr/* ]] && hypr_changed=1
        [[ "$rel" == .config/quickshell/* ]] && shell_changed=1
        [[ "$rel" == .config/systemd/user/* ]] && units_changed=1
    done <<< "$changed"

    # New unit files first, so a shell restart below already uses them (KillMode=process keeps the apps the
    # shell opened running through the restart).
    if (( units_changed )); then
        systemctl --user daemon-reload 2>/dev/null || true
    fi

    # Only what changed is reloaded: Hyprland reads its config once, and the shell's QML is
    # restarted (not the whole session) so new files are compiled.
    if (( hypr_changed )) && pgrep -x Hyprland >/dev/null; then
        hyprctl reload >/dev/null 2>&1 || true
    fi
    # A theme applied before this update may have gained settings (Red Sun turning on the revolver) or a new name;
    # apply it again so they take effect. With no theme on, this just rewrites the browser themes.
    local theme_tool="$HOME/.config/hypr/hyprland/halcyon/halcyon-theme"
    if [[ -x "$theme_tool" ]]; then
        # shellcheck disable=SC2086
        "$theme_tool" migrate --changed $changed >/dev/null 2>&1 || echo "note: re-applying the theme failed; pick it again in the theme menu"
    fi
    echo "$after" > "$INSTALLED_FILE"
    echo "$after" > "$SEEN_FILE"
    rm -f "$AVAILABLE_FILE" "$ERROR_FILE"
    [[ -d "$backup" ]] && echo "Replaced files were backed up to $backup"
    local body="$copied file(s) copied, now at $(g log -1 --format=%h "$after")."
    (( from_archive )) && body+=" The Halcyon folder is a git clone from now on."
    (( needs_install )) && body+=" Install steps or packages changed: run ./setup install in $REPO to finish."
    notify "Halcyon updated" "$body"
    [[ "$what" == all ]] && plus_apply
    # Last, since restarting the shell ends a run that the shell itself started.
    if (( shell_changed )) && systemctl --user is-active --quiet halcyon-quickshell.service 2>/dev/null; then
        systemctl --user restart halcyon-quickshell.service || true
    fi
}

status() {
    MODE=status
    repo
    local branch kind="git clone"
    has_commits || kind="release archive (becomes a clone on its first update)"
    branch="$(g symbolic-ref --quiet --short HEAD 2>/dev/null || echo "detached")"
    echo "folder:          $REPO ($kind)"
    has_commits && echo "branch:          $branch at $(g rev-parse --short HEAD)"
    [[ -f "$INSTALLED_FILE" ]] && echo "installed:       $(cut -c1-7 "$INSTALLED_FILE")"
    if [[ -f "$CHECKED_FILE" ]]; then
        echo "last check:      $(date -d "@$(cat "$CHECKED_FILE")" '+%Y-%m-%d %H:%M' 2>/dev/null || cat "$CHECKED_FILE")"
    else
        echo "last check:      never"
    fi
    if [[ -f "$AVAILABLE_FILE" ]]; then
        echo "updates waiting: $(cat "$AVAILABLE_FILE")  (update apply, or the bar's update button)"
    else
        echo "updates waiting: none"
    fi
    if command -v systemctl >/dev/null 2>&1; then
        echo "timer:           $(systemctl --user is-enabled halcyon-update.timer 2>/dev/null || echo "not enabled") (checks hourly)"
    fi
    plus_check
    case "$PLUS_STATE" in
        none) echo "hyprland-plus:   not installed" ;;
        aur) echo "hyprland-plus:   from the AUR (update apply runs your AUR helper)" ;;
        *) echo "hyprland-plus:   $PLUS_LINE" ;;
    esac
    [[ -f "$ERROR_FILE" ]] && echo "last problem:    $(cat "$ERROR_FILE")"
    return 0
}

case "${1:-check}" in
    check) check ;;
    apply) apply "${2:-all}" ;;
    status) status ;;
    *) echo "usage: update [check|apply [halcyon|hyprland-plus]|status]" >&2; exit 2 ;;
esac
