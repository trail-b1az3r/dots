#!/usr/bin/env python3
"""Halcyon's voice assistant. `halcyon-assistant --help` (or `halcyon assistant --help`)."""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
STATE = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
VENV = os.path.join(STATE, "halcyon/assistant/venv")

# Speech recognition and the SDKs live in the assistant's own virtual
# environment (made by `setup`), so run inside it when it exists. Setup
# itself runs on the system Python, since it creates that environment.
if (os.path.exists(os.path.join(VENV, "bin/python")) and os.path.realpath(sys.prefix) != os.path.realpath(VENV)
        and sys.argv[1:2] != ["setup"]):
    python = os.path.join(VENV, "bin/python")
    os.execv(python, [python, os.path.realpath(__file__), *sys.argv[1:]])

sys.path.insert(0, HERE)
from halcyon_assistant.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
