#!/usr/bin/env bash
# Halcyon: minimise every window on this workspace, or bring them back.
#
# Minimised windows are moved to the hidden special workspace
# `special:halcyon-minimized`, which is how Hyprland keeps windows out of
# sight without closing them. Running this again restores every window in
# that workspace to the current one.
#
#   minimize-all            minimise, or restore if any are already minimised
#   minimize-all minimise   only minimise
#   minimize-all restore    only restore

set -euo pipefail

action="${1:-toggle}"
hidden="special:halcyon-minimized"

if ! command -v hyprctl >/dev/null 2>&1; then
    notify-send -a Hyprland "Minimise all needs Hyprland" 2>/dev/null || true
    exit 1
fi

exec python3 - "$action" "$hidden" <<'PY'
import json
import subprocess
import sys

action, hidden = sys.argv[1], sys.argv[2]


def hyprctl(*args):
    out = subprocess.run(["hyprctl", *args], capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def dispatch(expression):
    # Lua dispatch syntax, as the rest of this configuration uses.
    subprocess.run(["hyprctl", "dispatch", expression], capture_output=True, text=True, check=False)


def move(address, workspace):
    dispatch(f"hl.dsp.window.move({{ workspace = {workspace}, follow = false, window = \"address:{address}\" }})")


active = hyprctl("activeworkspace")
clients = hyprctl("clients")
minimised = [c for c in clients if c.get("workspace", {}).get("name") == hidden]
here = [
    c for c in clients
    if c.get("workspace", {}).get("id") == active["id"] and c.get("mapped", True) and not c.get("hidden", False)
]

if action == "toggle":
    action = "restore" if minimised else "minimise"

if action == "minimise":
    for client in here:
        move(client["address"], f'"{hidden}"')
elif action == "restore":
    for client in minimised:
        move(client["address"], active["id"])
else:
    sys.exit(f"unknown action: {action}")
PY
