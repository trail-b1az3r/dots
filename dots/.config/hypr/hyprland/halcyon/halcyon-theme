def cmd_menu(_args):
    if not shutil.which("fuzzel"):
        raise ThemeError("fuzzel is not installed")
    current = active()
    entries = {}
    for theme_id in theme_ids():
        theme = load(theme_id)
        entries[f"{theme['name']}{'  (active)' if theme_id == current else ''}"] = ("apply", theme_id)
    entries["Off: follow the wallpaper"] = ("off", None)
    if current is not None:
        level = effects_for(load(current))
        for option in EFFECT_LEVELS:
            label = f"Effects: {option}{'  (current)' if option == level else ''}"
            entries[label] = ("effects", option)
    choice = subprocess.run(
        ["fuzzel", "--dmenu", "--prompt", "Theme  "],
        input="\n".join(entries), capture_output=True, text=True, check=False,
    ).stdout.strip()
    if not choice:
        return 0
    if choice not in entries:
        raise ThemeError(f"unknown choice {choice!r}")
    action, value = entries[choice]
    if action == "apply":
        return cmd_apply([value])
    if action == "effects":
        return cmd_effects([value])
    return cmd_off([])


