def starrail_enabled():
    """Whether the user has turned Star Rail characters on in Settings."""
    try:
        data = json.loads(SHELL_CONFIG.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    return data.get("halcyon", {}).get("starRail", {}).get("enable") is True


def ensure_starrail_banner():
    """The Star Rail theme shows a character. Applying it is the request for one.

    With a banner already set, nothing happens. Otherwise a character is
    picked from the cache, or the index is fetched first if the cache is empty.
    A failure leaves the plain wallpaper in place, with a note.
    """
    meta_path, image = banner_files("hsr")
    if image is not None or not starrail_enabled():
        return
    sys.path.insert(0, str(HERE))
    import starrail

    try:
        if not starrail.load_characters():
            starrail.refresh()
        char = starrail.choose_next() or starrail.current()
        if char is None:
            raise starrail.StarRailError("no characters are available")
        portrait = Path(starrail.portrait(char))
        BANNERS.mkdir(parents=True, exist_ok=True)
        for old in BANNERS.glob("hsr.*"):
            old.unlink()
        shutil.copyfile(portrait, BANNERS / f"hsr{portrait.suffix.lower()}")
        write_atomic(meta_path, json.dumps(
            {"title": char.name, "subtitle": f"{char.element} · {char.path}"},
            indent=2, ensure_ascii=False) + "\n")
    except starrail.StarRailError as error:
        print(f"note: no Star Rail character yet ({error}); the plain wallpaper is used",
              file=sys.stderr)


def wallpaper_hint(wallpaper, theme=None):
    """How to get a theme's video wallpaper when it is not on the machine (they are not shipped)."""
    try:
        import halcyon_wallpapers
    except ImportError:
        return ""
    if theme and theme.get("wallpaper_invert_of"):
        # Made from another theme's: point at that one.
        wallpaper = Path(os.path.expanduser(theme["wallpaper_invert_of"]))
    for entry_id, entry in halcyon_wallpapers.CATALOG.items():
        if halcyon_wallpapers.target(entry_id) == wallpaper:
            how = "get" if entry.get("url") else "import"
            tail = "" if entry.get("url") else " FILE"
            return f"      `halcyon wallpapers {how} {entry_id}{tail}` brings it ({entry['page']}), then apply the theme again"
    return ""


# Light turned to dark with the hues kept: negate flips every channel (and so the hue), hue=h=180 turns it back.
INVERT_FILTER = "negate,hue=h=180"


def derive_wallpaper(theme, wallpaper):
    """A theme whose wallpaper is another's in negative (wallpaper_invert_of): make it with ffmpeg, once, and again
    when the original is newer. Returns True when the wallpaper is there to use."""
    source_name = theme.get("wallpaper_invert_of")
    if not source_name:
        return wallpaper.is_file()
    source = Path(os.path.expanduser(source_name))
    if not source.is_file():
        return wallpaper.is_file()
    if wallpaper.is_file() and wallpaper.stat().st_mtime >= source.stat().st_mtime:
        return True
    if not shutil.which("ffmpeg"):
        print("note: ffmpeg is needed to make the inverted wallpaper (sudo pacman -S ffmpeg)", file=sys.stderr)
        return wallpaper.is_file()
    notify(f"{theme['name']} theme", "Making its wallpaper: the original in negative. This takes a moment, once.")
    staging = wallpaper.with_name(".part-" + wallpaper.name)
    video = wallpaper.suffix.lower() in (".mp4", ".webm", ".mkv", ".mov")
    command = ["ffmpeg", "-y", "-loglevel", "error", "-i", str(source), "-vf", INVERT_FILTER]
    if video:
        command += ["-an", "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p"]
    wallpaper.parent.mkdir(parents=True, exist_ok=True)
    done = subprocess.run([*command, str(staging)], capture_output=True, text=True, check=False, timeout=1800)
    if done.returncode != 0 or not staging.is_file():
        staging.unlink(missing_ok=True)
        print(f"note: could not invert {source}: {done.stderr.strip()[-300:]}", file=sys.stderr)
        return wallpaper.is_file()
    os.replace(staging, wallpaper)
    return True


def fetch_wallpaper(wallpaper):
    """A theme's still wallpaper that isn't here yet and can be downloaded: get it now (they are small)."""
    try:
        import halcyon_wallpapers
    except ImportError:
        return False
    for entry_id, entry in halcyon_wallpapers.CATALOG.items():
        if halcyon_wallpapers.target(entry_id) == wallpaper and entry.get("url") and entry.get("kind") == "image":
            try:
                halcyon_wallpapers.download(entry_id)
                return True
            except halcyon_wallpapers.WallpaperError as error:
                print(f"note: {error}", file=sys.stderr)
    return False


def cmd_apply(args):
    if len(args) != 1:
        raise ThemeError("usage: halcyon-theme apply NAME")
    theme_id = RENAMED.get(args[0], args[0])
    theme = load(theme_id)
    if not SWITCHWALL.is_file():
        raise ThemeError(f"{SWITCHWALL} not found. Is illogical-impulse installed?")

    # Fully leave the previous theme first, so a failure part way through
    # leaves no theme half-applied.
    previous = active()
    leave_theme()
    write_atomic(APPLY_LOG, f"halcyon-theme apply {theme_id}\n")
    if previous != theme_id:
        run_switch_rules("from", previous)

    wallpaper = resolve_wallpaper(theme)
    derive_wallpaper(theme, wallpaper)
    if not wallpaper.is_file():
        fetch_wallpaper(wallpaper)
    if wallpaper.is_file():
        if theme_id == "hsr":
            ensure_starrail_banner()
        wallpaper = compose_banner(theme_id, theme, wallpaper)
        run([str(SWITCHWALL), "--mode", "dark", "--image", str(wallpaper)])
    else:
        print(f"note: wallpaper {wallpaper} not found, keeping the current one", file=sys.stderr)
        print(wallpaper_hint(wallpaper, theme), file=sys.stderr)
    run([str(SWITCHWALL), "--mode", "dark", "--noswitch",
         "--type", theme["scheme"], "--color", theme["seed"]])

    colors_json = GENERATED / "colors.json"
    existing = colors_json.read_text(encoding="utf-8") if colors_json.is_file() else ""
    write_atomic(colors_json, overlay_colors(existing, theme))

    scss = GENERATED / "material_colors.scss"
    existing = scss.read_text(encoding="utf-8") if scss.is_file() else ""
    write_atomic(scss, overlay_scss(existing, theme))
    if APPLYCOLOR.is_file():
        run([str(APPLYCOLOR)])

    apply_shell_config(theme)
    if previous != theme_id:
        run_switch_rules("to", theme_id)
        theme_icons(theme_id)
    effects, native = write_window_style(theme_id, theme)
    write_atomic(ACTIVE_FILE, theme_id + "\n")
    set_shell_value("halcyon.theme", theme_id)
    set_shell_value("halcyon.glassTheme", is_glass(theme))
    reload_hyprland()

    body = theme["description"]
    if effects == "full" and theme.get("effects", {}).get("shader_trigger") == "revolver":
        body += "\nSpin the revolver to break the screen (Settings > Background > Widgets turns it on)."
    elif effects == "full" and theme.get("effects", {}).get("screen_shader"):
        body += "\nScreen effects use more GPU. Settings > Halcyon to tone them down."
    update_browsers()
    notify(f"{theme['name']} theme", body)
    print(f"applied {theme_id} (effects: {effects}{', native glass' if native else ''})")
    return 0


def update_browsers():
    """Firefox and Chromium follow the new colours (halcyon_browsers.py), and so do Avizo and Wayscriber
    (halcyon_overlays.py). Never fatal: a theme is not a browser."""
    for tool, args in (("halcyon_browsers.py", ["update", "--quiet"]), ("halcyon_overlays.py", ["overlays", "sync", "--quiet"])):
        try:
            subprocess.run([sys.executable, str(HERE / tool), *args],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=60, check=False)
        except (OSError, subprocess.SubprocessError):
            pass


def cmd_effects(args):
    current = active()
    if not args:
        if current is None:
            print(f"no theme active (effects setting: {effects_setting()})")
        else:
            print(effects_for(load(current)))
        if EFFECTS_HOLD.exists():
            print("held off by gpu-guard while a game works the GPU; they come back on their own")
        return 0
    quiet = "--quiet" in args
    args = [a for a in args if a != "--quiet"]
    level = args[0]
    before = effects_for(load(current)) if current is not None else None
    if level == "hold":
        # gpu-guard's switch: no setting is changed and nothing is announced
        if args[1:] == ["on"]:
            write_atomic(EFFECTS_HOLD, "1\n")
        elif args[1:] == ["off"]:
            remove(EFFECTS_HOLD)
        else:
            raise ThemeError("usage: halcyon-theme effects hold on|off")
        quiet = True
    elif level == "flip":
        if read_state(FLIP_FILE):
            remove(FLIP_FILE)
            print("pointer effects: normal")
        else:
            write_atomic(FLIP_FILE, "1\n")
            print("pointer effects: flipped vertically")
    elif level == "default" or level in EFFECT_LEVELS:
        set_shell_value("halcyon.effects", level)
    else:
        raise ThemeError("usage: halcyon-theme effects [full|light|off|default|flip] [--quiet]")
    if current is not None:
        effects = effects_for(load(current))
        if effects != before or level == "flip":
            write_window_style(current, load(current))
            reload_hyprland()
            # Only a change you asked for is announced, and only when it changed something.
            if not quiet and level != "flip":
                notify("Effects", f"Now {effects}.")
        print(f"effects: {effects}")
    return 0


