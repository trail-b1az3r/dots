def cmd_starrail(args):
    """Star Rail characters: refresh the index, or put another character on the banner."""
    import argparse

    sys.path.insert(0, str(HERE))
    import starrail

    parser = argparse.ArgumentParser(prog="halcyon-theme starrail")
    sub = parser.add_subparsers(dest="action", required=True)
    refresh = sub.add_parser("refresh", help="download the public character index now")
    refresh.add_argument("--force", action="store_true")
    sub.add_parser("next", help="show another character on the Star Rail banner")
    status = sub.add_parser("status", help="what is cached and what is showing")
    status.add_argument("--json", action="store_true")
    options = parser.parse_args(args)

    if options.action in ("refresh", "next") and not starrail_enabled():
        raise ThemeError("Star Rail characters are off; turn them on in Settings > Halcyon")
    try:
        if options.action == "refresh":
            count = starrail.refresh(force=options.force)
            print(f"character index is current: {count} characters")
            return 0
        if options.action == "next":
            char = starrail.choose_next()
            if char is None:
                starrail.refresh()
                char = starrail.choose_next()
            if char is None:
                raise ThemeError("no characters are cached; run `halcyon-theme starrail refresh`")
            portrait = starrail.portrait(char)
            cmd_banner(["hsr", portrait, "--title", char.name,
                        "--subtitle", f"{char.element} · {char.path}"])
            print(f"showing {char.name} ({char.element}, {char.path})")
            return 0
        payload = starrail.status()
        if options.json:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
            return 0
        current = payload["current"]
        print(f"characters cached: {payload['characters']}")
