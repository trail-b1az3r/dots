    scan.add_argument("--mode", choices=revolver.MODES, default="recent")
    scan.add_argument("--json", action="store_true")
    fire = sub.add_parser("fire", help="start one game")
    fire.add_argument("source", choices=revolver.SOURCES)
    fire.add_argument("game_id")
    art = sub.add_parser("art", help="the art Steam keeps for a game, as JSON (the launch card uses it)")
    art.add_argument("source", choices=revolver.SOURCES)
    art.add_argument("game_id")
    sub.add_parser("status", help="whether it is on, where it shows, and any error the shell logged for it")
    sub.add_parser("on", help="turn it on")
    sub.add_parser("off", help="turn it off")
