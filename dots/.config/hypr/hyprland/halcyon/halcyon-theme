def banner_files(theme_id):
    meta = BANNERS / f"{theme_id}.json"
    images = sorted(p for p in BANNERS.glob(f"{theme_id}.*") if p.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp"))
    return meta, (images[0] if images else None)


def banner_python():
    """Pillow lives in illogical-impulse's virtual environment."""
    venv = os.environ.get("ILLOGICAL_IMPULSE_VIRTUAL_ENV")
    if venv:
        candidate = Path(os.path.expanduser(venv)) / "bin/python"
        if candidate.exists():
            return str(candidate)
    return sys.executable


def compose_banner(theme_id, theme, wallpaper):
    """Return the wallpaper to use: the theme's own, or it with a banner."""
    if "banner" not in theme:
        return wallpaper
    meta_path, image = banner_files(theme_id)
    if image is None:
        return wallpaper
    try:
        meta = json.loads(meta_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        meta = {}
    out = HALCYON_STATE / f"banner-{theme_id}.jpg"
    out.parent.mkdir(parents=True, exist_ok=True)
    cmd = [banner_python(), str(BANNER_TOOL), "--background", str(wallpaper), "--art", str(image),
           "--out", str(out), "--frame", theme["banner"].get("frame", theme["shell"]["primary"]),
           "--glow", theme["banner"].get("glow", theme["shell"]["secondary"])]
    if meta.get("title"):
        cmd += ["--title", meta["title"]]
    if meta.get("subtitle"):
        cmd += ["--subtitle", meta["subtitle"]]
    result = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if result.returncode != 0 or not out.is_file():
        print(f"note: could not compose the banner, using the plain wallpaper\n{result.stderr}", file=sys.stderr)
        return wallpaper
    return out


