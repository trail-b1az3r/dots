    return 0


COLLAPSE_STATE = HALCYON_STATE / "collapse.json"
COLLAPSE_SECONDS = 11.4  # the shader's DURATION (spin, eye, tape, rewind), plus a margin for the arm to arrive
COLLAPSE_SECONDS_NO_TAPE = 7.5  # without the tape the screen fades back after the eye (DURATION 6.7)
# Where the car on the road is, from the ring's centre, as fractions of the screen, in the Red Sun wallpaper
# (the car is at 0.6485, 0.7084 of it, the ring at 0.4907, 0.4312). Used when the revolver does not say.
CAR_FROM_RING = (0.1578, 0.2772)


def hyprland_eval(lua):
    """Run Lua in the running Hyprland. True when it answered without an error."""
    if not hyprland_running():
        return False
    result = subprocess.run(["hyprctl", "eval", lua], capture_output=True, text=True, check=False)
    text = (result.stdout + result.stderr).lower()
    return result.returncode == 0 and "error" not in text


def collapse_arm(age, ring_x, ring_y, ring_r, car_x=None, car_y=None):
    """Switch the active theme's triggered shader in, armed for a spin that started `age` seconds ago at the
    ring (x, y as 0..1 of the screen, r as a fraction of its height), with the car the eye looks at (0..1 of the
    screen; by default where it is in the wallpaper relative to the ring). Returns a reason when it does nothing."""
    current = active()
    if current is None:
        return "no theme is active"
    theme = load(current)
    if theme.get("effects", {}).get("shader_trigger") != "revolver":
        return f"{theme['name']} has no revolver effect"
    if effects_for(theme) != "full":
        return "the effects level is not full"
    # Settings > Revolver > Red Sun sequence.
    revolver = get_nested(read_shell_config(), "background.widgets.revolver")
    revolver = revolver if isinstance(revolver, dict) else {}
    if revolver.get("sequence", True) is False:
        return "the Red Sun sequence is off in Settings"
    tape = revolver.get("tape", True) is not False
    text = render_shader(theme, bool(read_state(FLIP_FILE)), glass_settings())
    knobs = {"EYE": "0" if revolver.get("eye", True) is False else "1", "TAPE": "1" if tape else "0",
             "QUALITY": "0" if revolver.get("quality") == "light" else "1",
             "COLLAPSE_ARMED": "1", "ARM_AGE": f"{max(0.0, min(float(age), 5.0)):.3f}",
             "RING_X": f"{float(ring_x):.4f}", "RING_Y": f"{float(ring_y):.4f}", "RING_R": f"{float(ring_r):.4f}"}
    if car_x is None or car_y is None:
        car_x, car_y = float(ring_x) + CAR_FROM_RING[0], float(ring_y) + CAR_FROM_RING[1]
    knobs["CAR_X"] = f"{min(max(float(car_x), 0.0), 1.0):.4f}"
    knobs["CAR_Y"] = f"{min(max(float(car_y), 0.0), 1.0):.4f}"
    for name, value in knobs.items():
        text = re.sub(rf"^#define {name} .*$", f"#define {name} {value}", text, count=1, flags=re.M)
    # A new path each time, so Hyprland compiles the new copy instead of keeping the old one.
    try:
        previous = json.loads(COLLAPSE_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        previous = {}
    token = int(previous.get("token", 0)) + 1
    path = HALCYON_STATE / f"screen-shader-armed-{token % 2}.frag"
    write_atomic(path, text)
    if not hyprland_eval(f'hl.config({{ decoration = {{ screen_shader = "{path}" }}, debug = {{ damage_tracking = 0 }} }})'):
        return "Hyprland did not take the shader"
    seconds = COLLAPSE_SECONDS if tape else COLLAPSE_SECONDS_NO_TAPE
    write_atomic(COLLAPSE_STATE, json.dumps({"token": token, "until": time.time() + seconds}) + "\n")
    # Disarm by itself afterwards, unless a newer spin has armed it again by then.
    subprocess.Popen(["sh", "-c", f'sleep {seconds}; exec "$0" collapse disarm --token {token}', str(HERE / "halcyon-theme")],
                     start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return None


def collapse_disarm(token=None):
    """Take the triggered shader out again, and turn damage tracking back on."""
    try:
        state = json.loads(COLLAPSE_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        state = {}
    if token is not None and int(state.get("token", -1)) != int(token):
        return "a newer spin is running"
    ok = hyprland_eval('hl.config({ decoration = { screen_shader = "" }, debug = { damage_tracking = 2 } })')
    if not ok:
        reload_hyprland()   # theme.lua has no shader for this theme, so a reload takes it out too
    for slot in (0, 1):
        remove(HALCYON_STATE / f"screen-shader-armed-{slot}.frag")
    remove(COLLAPSE_STATE)
    return None


def cmd_collapse(args):
    """`collapse arm AGE X Y R [CAR_X CAR_Y]` (the revolver runs this when a spin lands), `collapse disarm`."""
    if len(args) in (5, 7) and args[0] == "arm":
        try:
            values = [float(a) for a in args[1:]]
        except ValueError:
            raise ThemeError("usage: halcyon-theme collapse arm AGE X Y R [CAR_X CAR_Y] (numbers)")
        reason = collapse_arm(*values)
        if reason:
            print(f"not armed: {reason}")
        return 0
    if args[:1] == ["disarm"]:
        token = args[2] if args[1:2] == ["--token"] and len(args) == 3 else None
        reason = collapse_disarm(token)
        if reason:
            print(f"not disarmed: {reason}")
        return 0
    raise ThemeError("usage: halcyon-theme collapse arm AGE X Y R [CAR_X CAR_Y] | disarm")


REVOLVER_ON_MARKER = HALCYON_STATE / "migrated-revolver-on"


def migrate_revolver_on():
    """Once: the revolver is on for every theme now, but the shell saved the old default (off) in config.json, and a
    Red Sun applied before this would switch it off again when left. Turn it on, and forget that restore. After this,
    turning it off in Settings stays off."""
    if REVOLVER_ON_MARKER.exists():
        return False
    key = "background.widgets.revolver.enable"
    data = read_shell_config()
    changed = get_nested(data, key) is not True
    if changed:
        set_nested(data, key, True)
        write_atomic(SHELL_CONFIG, json.dumps(data, indent=2) + "\n")
    try:
        restore = json.loads(SHELL_RESTORE.read_text(encoding="utf-8"))
        if key in restore:
            del restore[key]
            write_atomic(SHELL_RESTORE, json.dumps(restore, indent=2) + "\n")
    except (OSError, ValueError):
        pass
    write_atomic(REVOLVER_ON_MARKER, "1\n")
    return changed


def cmd_migrate(args):
    """Bring a theme applied by an older Halcyon up to date (login and `update apply` run this).

    A renamed theme (wallpaper-heaven-kenami is now red-sun) is applied again under its new name, and so is a theme
    whose files changed (`--changed FILE...`, the paths an update copied), so settings a theme gained since it was
    applied, like Red Sun turning on the revolver, take effect without picking the theme again. Otherwise only the
    browser themes are written, which is cheap and covers profiles made since.
    """
    migrate_revolver_on()
    if migrate_placement() and hyprland_running():
        subprocess.run(["hyprctl", "reload"], capture_output=True, check=False)
    raw = read_state(ACTIVE_FILE)
    current = RENAMED.get(raw, raw) if raw else None
    changed = args[args.index("--changed") + 1:] if "--changed" in args else []
    stale = current is not None and (raw != current or any(
        f"halcyon/themes/{current}.json" in path or f"halcyon/themes/shaders/{current}" in path for path in changed))
    shell_says = (read_shell_config().get("halcyon") or {}).get("theme")
    if current is not None and shell_says in RENAMED:
        stale = True  # the shell still has the old name, so its theme-specific parts (the ring) are off
    if stale and theme_path(current).is_file():
        print(f"applying {current} again" + (f" (it was called {raw})" if raw != current else ""))
        return cmd_apply([current])
    update_browsers()
    return 0


