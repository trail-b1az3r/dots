def revolver_status(revolver):
    """What decides whether the revolver is on screen, in one place, so a report needs one command's output."""
    config = read_shell_config()
    entry = get_nested(config, "background.widgets.revolver")
    entry = entry if isinstance(entry, dict) else {}
    enabled = entry.get("enable", True) is not False
    family = get_nested(config, "panelFamily")
    family = family if isinstance(family, str) else "ii"
    theme = active()
    print(f"enabled      {'yes' if enabled else 'no  (halcyon revolver on, or Settings > Background > Widgets)'}")
    print(f"theme        {theme or 'none'}")
    if theme == "red-sun":
        wallpaper = str(get_nested(config, "background.wallpaperPath") or "")
        # The same test the shell makes (Background.qml): any copy of the Red Sun picture.
        is_red_sun = re.search(r"/(banner-)?(red-sun|wallpaper-heaven-kenami)[^/]*\.(jpe?g|png|webp)$", wallpaper, re.I)
        if entry.get("followRing", True) is False:
            print("on the ring  no: Follow the ring is off (Settings > Background > Revolver)")
        elif not is_red_sun:
            print(f"on the ring  no: the wallpaper isn't the Red Sun picture ({wallpaper or 'none'})")
        else:
            print("on the ring  yes (it sits on the painted ring)")
    print(f"panel family {family}")
    if not (theme == "red-sun" and entry.get("followRing", True)):
        print(f"place        x {entry.get('x', 1400)}, y {entry.get('y', 520)}, size {entry.get('size', 300)}")
    source, mode = entry.get("source", "steam"), entry.get("mode", "recent")
    try:
        games = len(revolver.pool(source, mode))
    except Exception as error:  # a broken library file must not hide the rest of the report
        games = f"could not read ({error})"
    print(f"games        {games} from {source} ({mode})")
    # What the shell said about it: the service's journal, else Quickshell's own log.
    lines = []
    if shutil.which("journalctl"):
        out = subprocess.run(["journalctl", "--user", "-u", "halcyon-quickshell.service", "-b", "--no-pager", "-o", "cat"],
                             capture_output=True, text=True, check=False).stdout
        lines = [l for l in out.splitlines() if re.search(r"[Rr]evolver", l)]
    if not lines and shutil.which("qs"):
        out = subprocess.run(["qs", "log", "-c", "ii"], capture_output=True, text=True, check=False, timeout=20)
        lines = [l for l in (out.stdout + out.stderr).splitlines() if re.search(r"[Rr]evolver", l)]
    if lines:
        print("shell log:")
        for line in lines[-15:]:
            print("  " + re.sub(r"\x1b\[[0-9;]*m", "", line))
    else:
        print("shell log    nothing about the revolver (it loaded, or the shell has not started it)")
    return 0


