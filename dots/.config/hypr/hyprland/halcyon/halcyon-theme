def cmd_doctor(args):
    """Why the revolver, the browser themes, updates, the Wi-Fi or the sound don't work, in one report; --fix fixes what it can.

    One command's output is enough to tell what is wrong on a machine nobody else can look at."""
    fix = "--fix" in args
    sys.path.insert(0, str(HERE))
    import halcyon_audio
    import halcyon_browsers
    import halcyon_wifi
    import revolver
    todo = []

    def heading(title):
        print(f"\n== {title}")

    heading("Updates")
    updater = HERE / "update"
    done = subprocess.run(["bash", str(updater), "status"], capture_output=True, text=True, check=False, timeout=60)
    print((done.stdout + done.stderr).rstrip())
    if "updates waiting: none" not in done.stdout:
        todo.append("updates are waiting" if "updates waiting:" in done.stdout else "the updater can't run")
        if fix:
            print("-> applying them")
            subprocess.run(["bash", str(updater), "apply"], check=False, timeout=600)

    heading("Revolver")
    shell_up = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "halcyon-quickshell.service"],
                              stderr=subprocess.DEVNULL, check=False).returncode == 0 or bool(shutil.which("pgrep") and subprocess.run(
                                  ["pgrep", "-x", "qs"], capture_output=True, check=False).returncode == 0)
    print(f"shell        {'running' if shell_up else 'NOT running (systemctl --user restart halcyon-quickshell)'}")
    revolver_status(revolver)
    if get_nested(read_shell_config(), "background.widgets.revolver.enable") is False:
        todo.append("the revolver is off")
        if fix:
            print("-> turning it on")
            set_shell_value("background.widgets.revolver.enable", True)
    print("(it is on the desktop, under the windows: an empty workspace shows it)")

    heading("Firefox and Chromium")
    info = halcyon_browsers.status()
    for item in info["firefox"]:
        state = "themed" if item["themed"] else "NOT themed"
        if item["restart_needed"]:
            state += ", but running since before: restart it to see the colours"
            todo.append(f"restart {item['browser']}")
        print(f"{item['browser']:<10} {state}  {item['profile']}")
        if not item["themed"]:
            todo.append(f"{item['browser']} isn't themed")
    if not info["firefox"]:
        print("Firefox    no profiles found (start Firefox once)")
    if not info["settings"]["firefox"]:
        print("Firefox    turned off in Settings > Halcyon > Browsers")
    if fix and info["settings"]["firefox"]:
        print("-> writing the browser themes")
        halcyon_browsers.update(quiet=True)

    heading("Wi-Fi")
    report = halcyon_wifi.status()
    halcyon_wifi.print_status(report)
    found = halcyon_wifi.problems(report)
    if found:
        todo.append("the Wi-Fi has problems")
        if fix:
            print("-> getting the Wi-Fi up for this session (halcyon wifi fix makes it last; it asks for sudo)")
            halcyon_wifi.boot()

    heading("Sound, microphones and webcams")
    report = halcyon_audio.status()
    halcyon_audio.print_status(report)
    if halcyon_audio.problems(report):
        todo.append("sound or the webcam has problems")
        if fix:
            print("-> putting the session right and restarting the sound services")
            halcyon_audio.fix()

    print()
    if not todo:
        print("Nothing wrong found.")
    elif fix:
        print("Fixed what could be fixed from here: " + "; ".join(todo) + ". Run halcyon doctor again to check.")
    else:
        print("To look at: " + "; ".join(todo) + ". `halcyon doctor --fix` fixes what it can.")
    return 0


# How a new window is placed. golden, cursor and golden-plus-dwindle are Hyprland's dwindle layout; the rest are
# Halcyon's own layouts in layouts.lua (registered as lua:halcyon-<mode>).
#
# Dwindle's default_split_ratio is the first window's share times two (1.0 is halves), so a golden split is
# 2 x 0.618 = 1.236. It used to be 1.618, which gave the first window 81 % and squeezed the new one to 19 %:
# open a few windows and all but one were slivers. split_bias 1 ("current") gives the 61.8 % to the window that
# was there, whichever side the new one opens on.
GOLDEN_SPLIT = 1.236
PLACEMENTS = {
    # (default_split_ratio, force_split, split_bias)
    "golden-dwindle": (GOLDEN_SPLIT, 0, 1),       # golden split, the new window on the side the cursor is on
    "cursor": (1.0, 0, 0),                        # halves, the side chosen by where the cursor is
    "golden-plus-dwindle": (GOLDEN_SPLIT, 2, 0),  # golden split, the new window always right or below
}
LUA_PLACEMENTS = {
    "golden": "the golden spiral: each window 61.8 % of what is left, turning left, top, right, bottom (default)",
    "stacked": "two windows at a time, one above the other; a third opens on the next empty workspace",
    "side-by-side": "two windows at a time, next to each other; a third opens on the next empty workspace",
    "mondrian": "each new window splits the biggest tile, on uneven ratios, like a Mondrian painting",
    "golden-plus": "golden ratio for many windows: one window 61.8 % wide, the others sharing the rest in equal tiles",
}
PLACEMENT_LUA = HALCYON_STATE / "placement.lua"


def placement_lua(mode):
    """The placement.lua for a mode. HALCYON_PLACEMENT tells layouts.lua which cap, if any, applies."""
    if mode in PLACEMENTS:
        ratio, force, bias = PLACEMENTS[mode]
        return (f"-- mode: {mode}\nHALCYON_PLACEMENT = \"{mode}\"\n"
                f"hl.config({{ general = {{ layout = \"dwindle\" }}, "
                f"dwindle = {{ default_split_ratio = {ratio}, force_split = {force}, split_bias = {bias} }} }})\n")
    return (f"-- mode: {mode}\nHALCYON_PLACEMENT = \"{mode}\"\n"
            f"hl.config({{ general = {{ layout = \"lua:halcyon-{mode}\" }} }})\n")


def migrate_placement():
    """Rewrite placement.lua when its mode is now written differently (golden used to split 81 / 19)."""
    try:
        text = PLACEMENT_LUA.read_text(encoding="utf-8")
        mode = text.splitlines()[0].split("mode:", 1)[1].strip()
    except (OSError, IndexError):
        return False
    if mode not in PLACEMENTS and mode not in LUA_PLACEMENTS:
        return False
    wanted = placement_lua(mode)
    if text == wanted:
        return False
    write_atomic(PLACEMENT_LUA, wanted)
    return True


def cmd_placement(args):
    """`placement` shows how new windows are placed; `placement MODE` changes it; `placement --list`."""
    modes = list(PLACEMENTS) + list(LUA_PLACEMENTS)
    current = "golden"
    try:
        head = PLACEMENT_LUA.read_text(encoding="utf-8").splitlines()[0]
        current = head.split("mode:", 1)[1].strip()
    except (OSError, IndexError):
