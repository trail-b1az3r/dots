def cmd_revolver(args):
    """The revolver widget's games: list the chambers, or start one."""
    import argparse

    sys.path.insert(0, str(HERE))
    import revolver

    parser = argparse.ArgumentParser(prog="halcyon-theme revolver")
    sub = parser.add_subparsers(dest="action", required=True)
    scan = sub.add_parser("scan", help="list the chambers and their weights")
