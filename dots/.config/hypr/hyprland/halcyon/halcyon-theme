def custom_themes():
    """Your own themes, for the Settings picker."""
    found = []
    for path in sorted(USER_THEMES_DIR.glob("*.json")) if USER_THEMES_DIR.is_dir() else []:
        try:
            theme = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        found.append({"id": path.stem, "name": str(theme.get("name", path.stem))})
    return found


def user_theme_path(theme_id):
    """The file of one of your own themes. Only plain ids: no paths, so nothing outside your folder."""
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", theme_id or ""):
        raise ThemeError(f"'{theme_id}' isn't the id of one of your themes")
    path = USER_THEMES_DIR / f"{theme_id}.json"
    if not path.is_file():
        raise ThemeError(f"no custom theme called '{theme_id}'. The built-in themes can't be changed")
    return path


def custom_change(args):
    """Duplicate or delete one of your own themes."""
    if len(args) < 2:
        raise ThemeError("usage: halcyon-theme custom duplicate ID | delete ID")
    path = user_theme_path(args[1])
    if args[0] == "delete":
        if active() == args[1]:
            leave_theme()
        path.unlink()
        print(f"deleted {args[1]}")
        return 0
    theme = json.loads(path.read_text(encoding="utf-8"))
    number = next(n for n in itertools.count(1) if not (USER_THEMES_DIR / f"custom-{n}.json").exists())
    theme["name"] = f"Copy of {theme.get('name', args[1])}"
    new_id = f"custom-{number}"
    write_atomic(USER_THEMES_DIR / f"{new_id}.json", json.dumps(theme, indent=2, ensure_ascii=False) + "\n")
    print(new_id)
    return 0


def hidden_themes():
    """Built-in themes hidden from Settings > Halcyon. Your own themes are never hidden."""
    value = get_nested(read_shell_config(), "halcyon.hiddenThemes")
    if not isinstance(value, list):
        return []
    builtin = {p.stem for p in THEMES_DIR.glob("*.json")}
    return [theme_id for theme_id in value if theme_id in builtin]


def scheduled_themes():
    """Auto-apply entries from Settings: theme, and any of time (HH:MM), days (ISO weekdays, empty for every day), weather."""
    value = get_nested(read_shell_config(), "halcyon.autoApply")
    if not isinstance(value, list):
        return []
    entries = [entry for entry in value if isinstance(entry, dict) and entry.get("theme")]
    return [dict(entry, theme=RENAMED.get(entry["theme"], entry["theme"])) for entry in entries]


# wttr.in weather codes, grouped the way the Settings card names them.
WEATHER_GROUPS = {
    "clear": {"113"},
    "cloudy": {"116", "119", "122"},
    "fog": {"143", "248", "260"},
    "rain": {"176", "185", "263", "266", "281", "284", "293", "296", "299", "302", "305", "308", "311", "314", "353", "356", "359"},
    "snow": {"179", "182", "227", "230", "317", "320", "323", "326", "329", "332", "335", "338", "350", "362", "365", "368", "371", "374", "377"},
    "storm": {"200", "386", "389", "392", "395"},
}
WEATHER_MAX_AGE = 3 * 3600


def weather_category():
    """The current weather group, from the code the bar's Weather service last fetched. None if unknown or old."""
    try:
        data = json.loads((STATE_DIR / "weather.json").read_text(encoding="utf-8"))
        if time.time() - float(data.get("time", 0)) > WEATHER_MAX_AGE:
            return None
        code = str(data.get("code", ""))
    except (OSError, ValueError, TypeError):
        return None
    return next((group for group, codes in WEATHER_GROUPS.items() if code in codes), None)


def sun_location():
    """(lat, lon, source) for sun times: Settings first, then the device's location (the shell saves it from GeoClue
    when location is on), then the weather's place. None if none of them."""
    stored = halcyon_sun.parse_location(get_nested(read_shell_config(), "halcyon.location"))
    if stored:
        return (*stored, "settings")
    try:
        device = json.loads((STATE_DIR / "location.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        device = None
    found = halcyon_sun.parse_location(device) if isinstance(device, dict) else None
    if found:
        return (*found, "device")
    try:
        data = json.loads((STATE_DIR / "weather.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    found = halcyon_sun.parse_location(data) if isinstance(data, dict) else None
    return (*found, "weather") if found else None


def entry_due(entry, now, category, location=None):
    """Whether an entry's time, days and weather all match right now. An entry with none of them never fires.

    `now` is timezone-aware. A time is "HH:MM", or "sunset"/"sunrise" with an optional offset in minutes, which
    needs `location` (lat, lon) and never fires without it.
    """
    if not any(key in entry for key in ("time", "days", "weather")):
        return False
    if "time" in entry:
        spec = entry["time"]
        if not halcyon_sun.is_time_spec(spec):
            return False
        if halcyon_sun.resolve(spec, now, location) != now.strftime("%H:%M"):
            return False
    days = entry.get("days") or []
    if days and now.isoweekday() not in days:
        return False
    weather = entry.get("weather") or ""
    return not weather or weather == category


def cmd_auto(args):
    """Run once a minute by halcyon-auto-theme.timer. Applies a schedule when it becomes due, not every minute it stays due. `auto list` shows them."""
    now = datetime.now().astimezone()
    place = sun_location()
    location = place[:2] if place else None
    if args == ["sun"]:
        sunrise, sunset = (halcyon_sun.resolve(event, now, location) for event in ("sunrise", "sunset"))
        print(json.dumps({"location": list(location) if location else None, "source": place[2] if place else None,
                          "sunrise": sunrise, "sunset": sunset}))
        return 0
    if args[:1] == ["day"]:
        # For the bar's sun dial: today's sun, how far through the day it is, and the next theme change.
        sunrise, sunset = (halcyon_sun.resolve(event, now, location) for event in ("sunrise", "sunset"))
        names = {}
        for theme_id in theme_ids():
            try:
                names[theme_id] = load(theme_id)["name"]
            except (ThemeError, ValueError):
                pass
        info = {"location": list(location) if location else None, "source": place[2] if place else None,
                "sunrise": sunrise, "sunset": sunset, "progress": halcyon_sun.day_progress(now, location),
                "now": now.strftime("%H:%M"), "active": active(),
                "next": halcyon_sun.next_due(scheduled_themes(), now, location, names)}
        if args[1:] == ["--json"]:
            print(json.dumps(info))
        else:
            print(f"sunrise {sunrise or '-'}  sunset {sunset or '-'}" + ("" if location else "  (no location yet)"))
            nxt = info["next"]
            print(f"next: {nxt['name']} {nxt['day']} at {nxt['at']}" if nxt else "next: nothing scheduled")
        return 0
    if args and args[0] == "location":
        if len(args) == 1:
            print(f"{place[0]:.4f},{place[1]:.4f} (from {place[2]})" if place else
                  "none: set one with `halcyon-theme auto location LAT,LON`, or turn on the bar's weather")
            return 0
        if args[1:] == ["clear"]:
            set_shell_value("halcyon.location", "")
            return 0
        value = " ".join(args[1:]).replace(" ", ",") if len(args) == 3 else args[1]
        if halcyon_sun.parse_location(value) is None:
            raise ThemeError("usage: halcyon-theme auto location LAT,LON (e.g. 51.51,-0.13) or clear")
        set_shell_value("halcyon.location", value)
        return 0
    if args == ["list"]:
        for entry in scheduled_themes():
            days = entry.get("days") or []
            when = ",".join(["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"][day - 1] for day in days) or "every day"
            spec = entry.get("time")
            if spec and not halcyon_sun.CLOCK_TIME.match(str(spec)):
                today = halcyon_sun.resolve(str(spec), now, location) if halcyon_sun.is_time_spec(spec) else None
                note = f"{today} today" if today else ("no location yet" if location is None else "not today")
                spec = f"{halcyon_sun.describe(str(spec))} ({note})"
            parts = [spec or "any time", when]
            if entry.get("weather"):
                parts.append(f"when {entry['weather']}")
            print(f"{entry['theme']:<16} " + ", ".join(parts))
        return 0
    if args:
        raise ThemeError("usage: halcyon-theme auto [list|sun|day [--json]|location [LAT,LON|clear]]")
    category = weather_category()
    entries = scheduled_themes()
    due = [entry for entry in entries if entry_due(entry, now, category, location)]
    due_keys = [json.dumps(entry, sort_keys=True) for entry in due]
    previous = set()
    try:
        previous = set(json.loads((STATE_DIR / "auto.json").read_text(encoding="utf-8")).get("due", []))
    except (OSError, ValueError, AttributeError):
        pass
    newly_due = [entry for entry, key in zip(due, due_keys) if key not in previous]
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    write_atomic(STATE_DIR / "auto.json", json.dumps({"due": due_keys}) + "\n")
    if not newly_due or active() == newly_due[-1]["theme"]:
        return 0
    try:
        return cmd_apply([newly_due[-1]["theme"]])
    except ThemeError as error:
        notify("Auto-apply didn't apply the theme", str(error))
        return 1


def cmd_show(args):
    """List hidden themes, or show one again (or `all`)."""
    hidden = hidden_themes()
    if not args:
        print("\n".join(hidden) if hidden else "No hidden themes.")
        return 0
    if args == ["all"]:
        remaining = []
    elif len(args) == 1 and args[0] in hidden:
        remaining = [theme_id for theme_id in hidden if theme_id != args[0]]
    else:
        raise ThemeError("usage: halcyon-theme show [ID|all]. Hidden now: " + (", ".join(hidden) or "none"))
    set_shell_value("halcyon.hiddenThemes", remaining)
    print("showing " + ("all themes" if args == ["all"] else args[0]))
    return 0


def cmd_custom(args):
    """Make your own themes. `new` copies the active theme (or Fractured Glass) to edit."""
    if not args or args[0] == "list":
        print(json.dumps(custom_themes(), ensure_ascii=False))
        return 0
    if args[0] == "path":
        print(USER_THEMES_DIR)
        return 0
    if args[0] in ("duplicate", "delete"):
        return custom_change(args)
    if args[0] == "open":
        if len(args) != 2:
            raise ThemeError("usage: halcyon-theme custom open ID")
        path = user_theme_path(args[1])
        if not shutil.which("xdg-open"):
            raise ThemeError(f"xdg-open not found. Open {path} in your editor")
        # The default app for .json, which is the editor for most people.
        subprocess.Popen(["xdg-open", str(path)], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    if args[0] != "new":
        raise ThemeError("usage: halcyon-theme custom [list|new [NAME]|duplicate ID|delete ID|open ID|path]")
    base_id = active() or "fractured-glass"
    base = load(base_id)
    number = next(n for n in itertools.count(1) if not (USER_THEMES_DIR / f"custom-{n}.json").exists())
    theme_id = f"custom-{number}"
    theme = json.loads(json.dumps(base))
    theme["name"] = " ".join(args[1:]).strip() or f"Custom {number}"
    theme["description"] = f"Your own copy of {base['name']}. Edit this file to change it."
    # Absolute paths, so the copy works from your own folder as well as the repository.
    theme["wallpaper"] = str(resolve_wallpaper(base))
    effects = theme.get("effects", {})
    if "screen_shader" in effects:
        effects["screen_shader"] = str(THEMES_DIR / effects["screen_shader"])
    problems = validate(theme_id, theme)
    if problems:
        raise ThemeError("couldn't make the theme:\n  " + "\n  ".join(problems))
    USER_THEMES_DIR.mkdir(parents=True, exist_ok=True)
    write_atomic(USER_THEMES_DIR / f"{theme_id}.json", json.dumps(theme, indent=2, ensure_ascii=False) + "\n")
    print(theme_id)
    return 0


