#!/bin/sh
# Halcyon: which desktop shell runs. One at a time:
#   ii        the Halcyon shell (halcyon-quickshell.service), for every theme but...
#   MacShell  ...the Liquid Glass theme's: a macOS Tahoe style menu bar, Dock and Liquid Glass (halcyon-macshell.service,
#             github.com/0-ss/MacShell, MIT), with MacLock as its lock screen.
# halcyon-theme writes the active theme's choice to ~/.local/state/halcyon/desktop-shell (absent: ii).
#
#   desktop-shell            print the shell that should run
#   desktop-shell unit       print its systemd unit
#   desktop-shell start      start it, unless it is already running (the other one stops: the units conflict)
#   desktop-shell restart    restart it (Hyprland does this at start-up)
#   desktop-shell ipc ...    qs ipc call ... on whichever is running
#   desktop-shell power-menu the power menu: the Halcyon shell's, or (under MacShell, which has none) the
#                            distribution's (<ID>-power-menu, from /etc/os-release), else wlogout
set -u

state="${XDG_STATE_HOME:-$HOME/.local/state}/halcyon/desktop-shell"
shell=ii
if [ -r "$state" ]; then
    read -r shell < "$state" || true
fi
# MacShell is Hyprland's only: under niri (or anything else) it is always the Halcyon shell.
if [ "$shell" = MacShell ] && [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && ! hyprctl version >/dev/null 2>&1; then
    shell=ii
fi
case "$shell" in
    MacShell) unit=halcyon-macshell.service ;;
    *) shell=ii; unit=halcyon-quickshell.service ;;
esac

case "${1:-}" in
    "") echo "$shell" ;;
    unit) echo "$unit" ;;
    start)
        systemctl --user is-active --quiet "$unit" && exit 0
        exec systemctl --user start "$unit" ;;
    restart) exec systemctl --user restart "$unit" ;;
    ipc) shift; exec qs -c "$shell" ipc call "$@" ;;
    power-menu)
        [ "$shell" = ii ] && exec qs -c ii ipc call session toggle
        id="$(sed -n 's/^ID=//p' "${OS_RELEASE:-/etc/os-release}" 2>/dev/null | tr -d "\"'" | head -n1)"
        for menu in ${id:+"$id-power-menu"} wlogout; do
            command -v "$menu" >/dev/null 2>&1 || continue
            [ "$menu" = wlogout ] && exec wlogout -p layer-shell
            exec "$menu"
        done
        exit 1 ;;
    *) echo "usage: desktop-shell [unit|start|restart|ipc ...|power-menu]" >&2; exit 2 ;;
esac
