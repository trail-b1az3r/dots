#!/bin/sh
# Halcyon: which desktop shell runs. One at a time:
#   ii        the Halcyon shell (halcyon-quickshell.service), for every theme but...
#   MacShell  ...the Liquid Glass theme's: a macOS Tahoe style menu bar, Dock and Liquid Glass (halcyon-macshell.service,
#             github.com/0-ss/MacShell, MIT), with MacLock as its lock screen.
#   Summit    ...the HyperNeo v2 theme's: a clean top bar and dock (halcyon-summit.service, ~/.config/quickshell/Summit),
#             with Rofi menus for apps, windows, the clipboard and power (halcyon/summit/rofi-menu).
#   Glass     the Halcyon shell over liquid glass (halcyon-quickshell.service; hyprland-plus's liquid blur)
#   Noctalia  Noctalia Shell v5 (halcyon-noctalia.service, the noctalia package, github.com/noctalia-dev/noctalia)
# halcyon-theme writes the shell to run to ~/.local/state/halcyon/desktop-shell (absent: ii): the one you picked with
# `halcyon shell`, else the active theme's.
#
#   desktop-shell            print the shell that should run
#   desktop-shell unit       print its systemd unit
#   desktop-shell start      start it, unless it is already running (the other one stops: the units conflict)
#   desktop-shell restart    restart it (Hyprland does this at start-up)
#   desktop-shell ipc ...    qs ipc call ... on whichever is running
#   desktop-shell shows-hypr-mode   true when the running shell shows hypr mode itself (the Halcyon shell and Summit
#                            do); otherwise Hyprland says it with a notification
#   desktop-shell power-menu the power menu: the Halcyon shell's, Summit's (Rofi), or (under MacShell, which has
#                            none) the distribution's (<ID>-power-menu, from /etc/os-release), else wlogout
set -u

state="${XDG_STATE_HOME:-$HOME/.local/state}/halcyon/desktop-shell"
shell=ii
if [ -r "$state" ]; then
    read -r shell < "$state" || true
fi
case "$shell" in
    MacShell) unit=halcyon-macshell.service ;;
    Summit) unit=halcyon-summit.service ;;
    Noctalia) unit=halcyon-noctalia.service ;;
    Glass) unit=halcyon-quickshell.service ;;
    *) shell=ii; unit=halcyon-quickshell.service ;;
esac

case "${1:-}" in
    "") echo "$shell" ;;
    unit) echo "$unit" ;;
    start)
        systemctl --user is-active --quiet "$unit" && exit 0
        exec systemctl --user start "$unit" ;;
    restart) exec systemctl --user restart "$unit" ;;
    ipc)
        shift
        [ "$shell" = Noctalia ] && exec noctalia msg "$@"
        [ "$shell" = Glass ] && shell=ii
        exec qs -c "$shell" ipc call "$@" ;;
    shows-hypr-mode)
        case "$shell" in
            ii|Glass) exec qs -c ii ipc call TEST_ALIVE >/dev/null 2>&1 ;;
            Summit) exec systemctl --user is-active --quiet halcyon-summit.service ;;
            *) exit 1 ;;
        esac ;;
    power-menu)
        case "$shell" in ii|Glass) exec qs -c ii ipc call session toggle ;; esac
        [ "$shell" = Noctalia ] && exec noctalia msg panel-toggle session
        [ "$shell" = Summit ] && exec "$(dirname -- "$0")/summit/rofi-menu" power
        id="$(sed -n 's/^ID=//p' "${OS_RELEASE:-/etc/os-release}" 2>/dev/null | tr -d "\"'" | head -n1)"
        for menu in ${id:+"$id-power-menu"} wlogout; do
            command -v "$menu" >/dev/null 2>&1 || continue
            [ "$menu" = wlogout ] && exec wlogout -p layer-shell
            exec "$menu"
        done
        exit 1 ;;
    *) echo "usage: desktop-shell [unit|start|restart|ipc ...|shows-hypr-mode|power-menu]" >&2; exit 2 ;;
esac
