{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/halcyon.txt",
    "color": {
      "1": "38;2;215;155;238",
      "2": "38;2;217;66;233",
      "3": "38;2;177;146;184",
      "4": "38;2;183;71;194",
      "5": "38;2;135;78;230",
      "6": "38;2;131;96;137",
      "7": "38;2;107;59;230",
      "8": "38;2;42;19;56",
      "9": "38;2;74;31;107"
    },
    "padding": { "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    {
      "type": "command",
      "key": "Halcyon",
      "text": "halcyon-theme current"
    },
    "break",
    "colors"
  ]
}
