{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Let the installed distribution's Fastfetch configuration/logo take
  // precedence instead of forcing Halcyon's per-user ASCII artwork.
  "display": { "separator": "  " },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    {
      "type": "command",
      "key": "Halcyon",
      "text": "halcyon-theme current"
    },
    "break",
    "colors"
  ]
}
