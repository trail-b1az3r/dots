{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/halcyon.txt",
    "color": {
      "1": "38;2;230;44;235",
      "2": "38;2;93;22;252",
      "3": "38;2;229;209;231",
      "4": "38;2;58;21;87"
    },
    "padding": { "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    {
      "type": "command",
      "key": "Halcyon",
      "text": "halcyon-theme current"
    },
    "break",
    "colors"
  ]
}
