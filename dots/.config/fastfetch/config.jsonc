{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "$HOME/.config/fastfetch/halcyon.txt",
    "width": 36,
    "height": 19,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages",
    "shell", "display", "wm", "terminal", "cpu", "gpu", "memory", "swap",
    "disk", "localip", "locale",
    { "type": "command", "key": "Halcyon", "text": "halcyon-theme current" },
    "break", "colors"
  ]
}
