  "mouseBinds": [
    {
      "id": "mouse.move",
      "title": "Drag window",
      "default": "SUPER + mouse:272",
      "run": {
        "dsp": "hl.dsp.window.drag()"
      }
    },
    {
      "id": "mouse.resize",
      "title": "Resize window",
      "default": "SUPER + mouse:273",
      "run": {
        "dsp": "hl.dsp.window.resize()"
      }
    }
  ]
}
