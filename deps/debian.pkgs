# Debian / Ubuntu package map.
#
# Debian ships neither Hyprland 0.56 nor Quickshell, so both are built
# from source by the installer.  Everything listed here is what those
# builds and the rest of the desktop need.

hyprland        -
hyprctl         -
quickshell      -
waybar          waybar
python          python3 python3-venv
pipewire        pipewire pipewire-pulse
wireplumber     wireplumber
wpctl           wireplumber
portal          xdg-desktop-portal xdg-desktop-portal-gtk
polkit-agent    policykit-1-gnome
hyprlock        -
hypridle        -
wl-clipboard    wl-clipboard
cliphist        -
grim            grim
slurp           slurp
screenrecord    wf-recorder
brightnessctl   brightnessctl
playerctl       playerctl
networkmanager  network-manager
bluez           bluez
upower          upower
libnotify       libnotify-bin
imagemagick     imagemagick
wallpaper       -
fonts-ui        fonts-inter
fonts-mono      fonts-jetbrains-mono
fonts-symbols   fonts-font-awesome
powerprofiles   power-profiles-daemon
ollama          -
piper           -
whisper         -
nixorb          -
hypernix        -

@build          build-essential cmake ninja-build git pkg-config meson
@quickshell-dev qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-declarative-private-dev qt6-wayland qt6-wayland-dev qt6-wayland-private-dev qt6-svg-dev qt6-shadertools-dev spirv-tools libcli11-dev libdrm-dev libgbm-dev libwayland-dev wayland-protocols libjemalloc-dev libpam0g-dev libpolkit-agent-1-dev libglib2.0-dev libpipewire-0.3-dev libxcb1-dev libvulkan-dev
@hyprland-dev   libwayland-dev wayland-protocols libdrm-dev libgbm-dev libxkbcommon-dev libinput-dev libseat-dev libdisplay-info-dev libliftoff-dev libpixman-1-dev libcairo2-dev libpango1.0-dev libxcb1-dev libxcb-composite0-dev libxcb-ewmh-dev libxcb-icccm4-dev libxcb-render-util0-dev libxcb-res0-dev libxcb-xinput-dev libxcb-errors-dev libtomlplusplus-dev libre2-dev liblua5.4-dev libmagic-dev libzip-dev librsvg2-dev libhwdata-dev
