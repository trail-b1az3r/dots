#!/usr/bin/env bash
# hyprctl-lite: installs or updates hyprland-plus, then removes itself.
#
# It does one thing, and no other command works:
#
#   sudo hyprctl-lite install full
#
# What that does, in order:
#   1. Clones hyprland-plus into ~/hyprland-plus of the account that ran sudo, or updates the clone.
#   2. Installs the build dependencies listed in that repository's packaging/aur/PKGBUILD.
#   3. Builds hyprland-plus as that account, not as root.
#   4. Installs hyprland-plus to /usr/local. The packaged Hyprland stays installed (copied to /usr/bin/hyprland.official):
#      other packages depend on it, and /usr/local/bin comes first in PATH.
#   5. Removes this file. If any step fails, the file is kept so the command can be run again.
#
# Install it with one command (also in the dots README):
#
#   curl -fsSL https://raw.githubusercontent.com/trail-b1az3r/dots/claude/youthful-gates-rt1csq-v2/tools/hyprctl-lite/hyprctl-lite | sudo tee /usr/local/bin/hyprctl-lite >/dev/null && sudo chmod 755 /usr/local/bin/hyprctl-lite
set -euo pipefail

REPO_URL="https://github.com/trail-b1az3r/hyprland-plus"
REF="halcyon-0.56.2"
# Bumped with each change, so an old downloaded copy is easy to spot in its output.
LITE_VERSION="2026-10-13"

usage() {
    printf 'usage: sudo hyprctl-lite install full\n'
    printf 'hyprctl-lite installs or updates hyprland-plus, then removes itself. It does nothing else.\n'
}

die() {
    printf 'hyprctl-lite: %s\n' "$*" >&2
    exit 1
}

if [[ $# -ne 2 || "$1" != install || "$2" != full ]]; then
    usage >&2
    exit 1
fi

[[ "$(id -u)" -eq 0 ]] || die "run it with sudo: sudo hyprctl-lite install full"

user="${SUDO_USER:-}"
[[ -n "$user" && "$user" != root ]] || die "run it with sudo from your own account, so hyprland-plus is built as you"
user_home="$(getent passwd "$user" | cut -d: -f6)"
[[ -n "$user_home" && -d "$user_home" ]] || die "could not find the home folder of $user"

command -v pacman >/dev/null 2>&1 || die "only Arch is supported here. Build hyprland-plus by hand: $REPO_URL"

repo="$user_home/hyprland-plus"
state="$user_home/.local/state/halcyon"
self="$(readlink -f "$0")"

# Runs a command as the account that ran sudo, with its home folder.
as_user() {
    sudo -u "$user" env HOME="$user_home" "$@"
}

step() {
    printf '\n==> %s\n' "$*"
}

trap 'printf "\nhyprctl-lite: the install did not finish. hyprctl-lite is kept, so you can run it again.\n" >&2' ERR

printf 'hyprctl-lite %s\n' "$LITE_VERSION"

step "Fetching hyprland-plus ($REF) into $repo"
if [[ -d "$repo/.git" ]]; then
    as_user git -C "$repo" fetch origin "$REF"
    as_user git -C "$repo" checkout "$REF"
    as_user git -C "$repo" pull --ff-only origin "$REF" || die "$repo has local changes that stop the update. Commit or stash them, then run this again."
else
    as_user git clone --branch "$REF" "$REPO_URL" "$repo"
fi
as_user git -C "$repo" submodule update --init --recursive

step "Installing the build dependencies (from packaging/aur/PKGBUILD)"
mapfile -t deps < <(bash -c 'source "$1" >/dev/null 2>&1; printf "%s\n" "${depends[@]}" "${makedepends[@]}"' _ "$repo/packaging/aur/PKGBUILD")
# Only the ones not already satisfied. pacman -T counts what other packages provide, so an installed
# -git variant (aquamarine-git, hyprland-protocols-git, ...) is left alone instead of conflicting.
mapfile -t missing < <(pacman -T -- "${deps[@]}" || true)
pacman -S --needed --noconfirm -- base-devel
if (( ${#missing[@]} > 0 )); then
    printf 'Installing: %s\n' "${missing[*]}"
    pacman -S --needed --noconfirm -- "${missing[@]}" || die "could not install the build dependencies: ${missing[*]}"
else
    printf 'All build dependencies are already installed.\n'
fi

step "Building hyprland-plus as $user (this takes a while)"
as_user make -C "$repo" all

if pacman -Q hyprland >/dev/null 2>&1; then
    step "Keeping a copy of the packaged Hyprland"
    # Not removed: illogical-impulse-hyprland and others depend on it. hyprland-plus in /usr/local/bin shadows it.
    [[ -e /usr/bin/hyprland.official ]] || cp /usr/bin/hyprland /usr/bin/hyprland.official
fi

step "Installing hyprland-plus to /usr/local"
make -C "$repo" install
ln -sf /usr/local/bin/Hyprland /usr/local/bin/hyprland

if [[ "$(command -v Hyprland)" != /usr/local/bin/Hyprland ]]; then
    echo "warning: PATH finds $(command -v Hyprland) first, not /usr/local/bin/Hyprland. Put /usr/local/bin before /usr/bin in PATH." >&2
fi

commit="$(as_user git -C "$repo" rev-parse --short HEAD)"
as_user mkdir -p "$state"
printf '%s\n' "$commit" | as_user tee "$state/hyprland-plus-commit" >/dev/null

trap - ERR
step "Cleaning up hyprctl-lite"
rm -f -- "$self"

printf '\nInstalled hyprland-plus %s. Log out and back in, or restart Hyprland, to run it.\n' "$commit"
